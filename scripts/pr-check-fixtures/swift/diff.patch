 /// Decides which shape the keypad takes in a given container, and how big its keys are. Each platform injects its own rule.
 protocol LayoutModeRule: Sendable {
     /// What presses the keys on the platform.
     var keySizing: KeySizing { get }
 
     /// The shape of the keypad for a container.
     ///
     /// - Parameters:
-    ///   - context: The size classes of the container the calculator is given.
+    ///   - context: The container the calculator is given and the posture of the device.
     /// - Returns: The mode to lay the keypad out in.
     func mode(for context: LayoutContext) -> KeypadLayoutMode
+
+    /// How far the keypad spreads on its sides, over the horizontal safe area.
+    ///
+    /// - Parameters:
+    ///   - context: The container the calculator is given and the posture of the device.
+    /// - Returns: How far to lay the keypad out towards the physical sides of the screen.
+    func keypadEdgeReach(in context: LayoutContext) -> KeypadEdgeReach
 }
