+//
+//  AxisExtensionTests.swift
+//  RPN CalculatorTests
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+import Testing
+@testable import RPN_Calculator
+
+@Suite
+struct AxisExtensionTests {
+    @Test
+    func `is horizontal for a rectangle wider than tall`() {
+        #expect(Axis(longSideOf: CGSize(width: 669, height: 40)) == .horizontal)
+    }
+
+    @Test
+    func `is vertical for a rectangle taller than wide`() {
+        #expect(Axis(longSideOf: CGSize(width: 40, height: 669)) == .vertical)
+    }
+
+    @Test
+    func `is vertical for a square`() {
+        #expect(Axis(longSideOf: CGSize(width: 100, height: 100)) == .vertical)
+    }
+}
