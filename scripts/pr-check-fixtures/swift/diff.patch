+++ b/RPN Calculator/Core/Layout/Rules/HingeRule.swift	
@@ -0,0 +1,68 @@
+//
+//  HingeRule.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// The rule of iPhone and iPad that also reads the posture of a foldable iPhone.
+///
+/// Without hinge or closed, the device is laid out by its fallback rule. Opened flat in landscape, the keypad is wide. The keypad spreads to the sides of the screen where its fallback rule spreads it.
+struct HingeRule: LayoutModeRule {
+    private let fallback: any LayoutModeRule
+
+    var keySizing: KeySizing {
+        fallback.keySizing
+    }
+
+    /// Creates the rule.
+    ///
+    /// - Parameters:
+    ///   - fallback: The rule for the postures this rule leaves alone. Defaults to the size classes.
+    init(fallback: any LayoutModeRule = SizeClassRule()) {
+        self.fallback = fallback
+    }
+
+    func mode(for context: LayoutContext) -> KeypadLayoutMode {
+        switch context.hingeStatus {
+        case .fullyOpen where context.containerAxis == .horizontal:
+            .wide
+        case .closed, .partiallyOpen, .fullyOpen, nil:
+            fallback.mode(for: context)
+        }
+    }
+
+    func keypadEdgeReach(in context: LayoutContext) -> KeypadEdgeReach {
+        fallback.keypadEdgeReach(in: context)
+    }
+}
+
+#if DEBUG
+import Playgrounds
+
+#Playground("HingeRule · no hinge") {
+    let rule: HingeRule = .init()
+    print("portrait:", rule.mode(for: .mock()))
+    print("landscape:", rule.mode(for: .mock(verticalSizeClass: .compact, containerAxis: .horizontal)))
+}
+
+#Playground("HingeRule · closed") {
+    let rule: HingeRule = .init()
+    print("portrait:", rule.mode(for: .mock(hingeStatus: .closed)))
+    print("landscape:", rule.mode(for: .mock(verticalSizeClass: .compact, containerAxis: .horizontal, hingeStatus: .closed)))
+}
+
+#Playground("HingeRule · opened flat") {
+    let rule: HingeRule = .init()
+    print("landscape:", rule.mode(for: .mock(horizontalSizeClass: .regular, containerAxis: .horizontal, hingeStatus: .fullyOpen)))
+    print("portrait:", rule.mode(for: .mock(horizontalSizeClass: .regular, hingeStatus: .fullyOpen)))
+}
+
+#Playground("HingeRule · half folded") {
+    let rule: HingeRule = .init()
+    print("fold across:", rule.mode(for: .mock(horizontalSizeClass: .regular, containerAxis: .horizontal, hingeStatus: .partiallyOpen, divisionAxis: .horizontal)))
+    print("fold down:", rule.mode(for: .mock(horizontalSizeClass: .regular, hingeStatus: .partiallyOpen, divisionAxis: .vertical)))
+}
+#endif
