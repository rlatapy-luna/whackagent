new file mode 100644
index 0000000..1a2b3c4
--- /dev/null
+++ b/src/sync/syncQueue.ts
@@ -0,0 +1,30 @@
+import type { ApiClient } from '../api/client'
+
+export type SyncPhase = 'idle' | 'running' | 'failed'
+
+export interface SyncJob {
+  id: string
+  attempts: number
+}
+
+export class SyncQueue {
+  private jobs: SyncJob[] = []
+  phase: SyncPhase = 'idle'
+
+  constructor(private readonly client: ApiClient) {}
+
+  push(job: SyncJob): void {
+    this.jobs.push(job)
+  }
+
+  async run(): Promise<void> {
+    this.phase = 'running'
+    try {
+      for (const job of this.jobs) await this.client.send(job.id)
+      this.phase = 'idle'
+    } catch {
+      this.phase = 'failed'
+    }
+  }
+}
