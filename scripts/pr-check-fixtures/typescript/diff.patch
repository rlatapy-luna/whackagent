+import type { SyncPhase } from '../sync/syncQueue'
+
+export function SyncBadge({ phase }: { phase: SyncPhase }) {
+  return (
+    <span className={`badge badge-${phase}`}>
+      {phase === 'failed' ? 'Sync failed' : 'Synced'}
+    </span>
+  )
+}
