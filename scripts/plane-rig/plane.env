# Non-secret settings for the local Plane CE rig (docker-compose.yml). Committed.
# Secrets (SECRET_KEY, LIVE_SERVER_SECRET_KEY, admin password, API key) are generated by
# `rig up` / `rig bootstrap` into the gitignored .env.local next to this file.

APP_RELEASE=v1.4.2
APP_DOMAIN=localhost

# Host port of the proxy, bound to 127.0.0.1 only. Clear of 3000/5173/8000/8080/8081/8888.
LISTEN_HTTP_PORT=8390
WEB_URL=http://localhost:8390
CORS_ALLOWED_ORIGINS=http://localhost:8390
SITE_ADDRESS=:80

DEBUG=0
GUNICORN_WORKERS=1
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880

# Plane's own per-API-key throttle (DRF rate, `<n>/<second|minute|hour|day>`). Upstream default is
# 60/minute; the provider requires it lifted. No off switch exists, so a huge per-second rate is the
# documented "unlimited" setting (verified: 400 parallel calls on one key, no 429).
API_KEY_RATE_LIMIT=1000000/second
AUTHENTICATION_RATE_LIMIT=10/minute

# Caddy (proxy) needs a CA URL in its config even when SITE_ADDRESS=:80 means no certificate is issued.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
