for i, size in enumerate(sizes, 1):
    if size not in have:
        EstimatePoint.objects.create(estimate=est, project=project, workspace=project.workspace, key=i, value=size)
        created.append("point " + size)
points = {{p.value: str(p.id) for p in EstimatePoint.objects.filter(estimate=est)}}
print("RIG-RESULT " + json.dumps({{"id": str(est.id), "points": points, "created": created}}))
"""


def ensure_estimate(key, pid, log):
    """Public API first; Plane CE 1.4.2 does not mount /api/v1 estimates (404), so fall back to the ORM."""
    base = f"workspaces/{WORKSPACE_SLUG}/projects/{pid}/estimates/"
    code, _ = api("GET", base, key=key, ok=(200, 404))
    if code == 200:
        raise Failure("this Plane mounts /api/v1 estimates: switch ensure_estimate to the public API")
    res = shell(SHELL_ESTIMATE, (pid, ESTIMATE_NAME, SIZES))
    log.extend(f"created {c}" for c in res["created"])
    eid = res["id"]
    _, proj = api("GET", f"workspaces/{WORKSPACE_SLUG}/projects/{pid}/", key=key)
    if proj.get("estimate") != eid:
        api("PATCH", f"workspaces/{WORKSPACE_SLUG}/projects/{pid}/", key=key, body={"estimate": eid})
        log.append("project estimate enabled")
    return eid, res["points"]


def cmd_bootstrap(_):
    ensure_secrets()
    wait_http(f"{plane_url()}/api/instances/", timeout=30)
    env = read_env(LOCAL_ENV)
    res = shell(SHELL_BOOTSTRAP, (ADMIN_EMAIL, env["PLANE_ADMIN_PASSWORD"], WORKSPACE_SLUG, WORKSPACE_NAME,
                                  TOKEN_LABEL))
    key = res["token"]
    log = [f"created {c}" for c in res["created"]]
    project, made = ensure_project(key)
    if made:
        log.append(f"project {PROJECT_IDENTIFIER} created")
    pid = project["id"]
    ensure_features(key, project, log)
    states = ensure_states(key, pid, log)
    eid, points = ensure_estimate(key, pid, log)
    write_local_env({
        "PLANE_URL": plane_url(), "PLANE_WORKSPACE": WORKSPACE_SLUG, "PLANE_PROJECT_ID": pid,
        "PLANE_ESTIMATE_ID": eid, "PLANE_ADMIN_EMAIL": ADMIN_EMAIL, "PLANE_API_KEY": key,
    })
    print("\n".join(log) if log else "nothing to do: already bootstrapped")
    print(f"states: {', '.join(states)}")
    print(f"sizes: {', '.join(points)}")
    print(f"login {plane_url()} as {ADMIN_EMAIL}, password in {LOCAL_ENV.relative_to(HERE.parent.parent)}")
    print(f'API key written to {LOCAL_ENV.relative_to(HERE.parent.parent)}. Export: eval "$(scripts/plane-rig/rig env)"')


def cmd_env(_):
    env = read_env(LOCAL_ENV)
    for k in ("PLANE_URL", "PLANE_WORKSPACE", "PLANE_PROJECT_ID", "PLANE_API_KEY"):
        if env.get(k):
            print(f"export {k}={env[k]}")


def cmd_status(_):
    if not docker_ready():
        print("docker: not answering")
        return
    compose("ps", "--format", "table {{.Service}}\t{{.Status}}")
    try:
        with urllib.request.urlopen(f"{plane_url()}/api/instances/", timeout=5) as r:
            inst = json.load(r)["instance"]
        print(f"plane: {plane_url()} version {inst['current_version']} edition {inst['edition']}")
    except (urllib.error.URLError, ConnectionError, socket.timeout, KeyError):
        print(f"plane: {plane_url()} not answering")
        return
    env = read_env(LOCAL_ENV)
    if env.get("PLANE_API_KEY") and env.get("PLANE_PROJECT_ID"):
        try:
            _, p = api("GET", f"workspaces/{WORKSPACE_SLUG}/projects/{env['PLANE_PROJECT_ID']}/")
            print(f"bootstrap: workspace {WORKSPACE_SLUG}, project {p['identifier']} ({p['id']}), API key OK")
        except Failure as e:
            print(f"bootstrap: API key or project not valid ({e}). Run `rig bootstrap`.")
    else:
        print("bootstrap: not run")
    print(f"runner: {runner_state()}")


# ---------------------------------------------------------------- runner

def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise Failure(f"gh {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def check_playground():
    name = gh("api", f"repos/{PLAYGROUND_REPO}", "--jq", ".full_name")
    if name != PLAYGROUND_REPO:
        raise Failure(f"repo identity check failed: {PLAYGROUND_REPO} resolves to {name}. Refusing.")


def cmd_playground(_):
    """Push the rig's Plane settings to the playground repo: API key secret + URL/workspace/project variables."""
    check_playground()
    env = read_env(LOCAL_ENV)
    if not env.get("PLANE_API_KEY"):
        raise Failure("no API key yet: `rig bootstrap` first")
    r = subprocess.run(["gh", "secret", "set", "PLANE_API_KEY", "-R", PLAYGROUND_REPO],
                       input=env["PLANE_API_KEY"], text=True, capture_output=True)
    if r.returncode != 0:
        raise Failure(f"gh secret set: {r.stderr.strip()}")
    for k in ("PLANE_URL", "PLANE_WORKSPACE", "PLANE_PROJECT_ID"):
        gh("variable", "set", k, "-R", PLAYGROUND_REPO, "-b", env[k])
    print(f"{PLAYGROUND_REPO}: secret PLANE_API_KEY, variables PLANE_URL PLANE_WORKSPACE PLANE_PROJECT_ID set")


def runner_pid():
    pidfile = RUNNER_DIR / ".rig.pid"
    if pidfile.exists():
        pid = int(pidfile.read_text().strip() or 0)
        try:
            os.kill(pid, 0)
            return pid
        except (OSError, ValueError):
            pidfile.unlink()
    return None


def runner_state():
    if not (RUNNER_DIR / ".runner").exists():
        return f"not registered ({RUNNER_DIR})"
    pid = runner_pid()
    return f"registered, {'running pid ' + str(pid) if pid else 'stopped'}"


def runner_register(_):
    check_playground()
    if (RUNNER_DIR / ".runner").exists():
        print(f"already registered in {RUNNER_DIR}")
        return
    RUNNER_DIR.mkdir(exist_ok=True)
    if not (RUNNER_DIR / "config.sh").exists():
        arch = {"arm64": "arm64", "x86_64": "x64"}[platform.machine()]
        rel = json.loads(gh("api", "repos/actions/runner/releases/latest"))
        ver = rel["tag_name"].lstrip("v")
        asset = f"actions-runner-osx-{arch}-{ver}.tar.gz"
        url = f"https://github.com/actions/runner/releases/download/v{ver}/{asset}"
        tgz = RUNNER_DIR / asset
        print(f"downloading {url}")
        urllib.request.urlretrieve(url, tgz)
        with tarfile.open(tgz) as t:
            t.extractall(RUNNER_DIR, filter="data")
        tgz.unlink()
    token = gh("api", "-X", "POST", f"repos/{PLAYGROUND_REPO}/actions/runners/registration-token", "--jq", ".token")
    name = f"{socket.gethostname().split('.')[0]}-whackagent"
    subprocess.run(["./config.sh", "--unattended", "--url", f"https://github.com/{PLAYGROUND_REPO}",
                    "--token", token, "--labels", RUNNER_LABEL, "--name", name, "--replace"],
                   cwd=RUNNER_DIR, check=True)
    print(f"runner {name} registered with label {RUNNER_LABEL}. Not a service: `rig runner start` when needed.")


def runner_start(_):
    if not (RUNNER_DIR / ".runner").exists():
        raise Failure("runner not registered: `rig runner register` first")
    if runner_pid():
        print(f"runner already {runner_state()}")
        return
    log = open(RUNNER_DIR / "rig-run.log", "a")
    p = subprocess.Popen(["./run.sh"], cwd=RUNNER_DIR, stdout=log, stderr=subprocess.STDOUT,
                         start_new_session=True)
    (RUNNER_DIR / ".rig.pid").write_text(str(p.pid))
    print(f"runner started, pid {p.pid}, log {RUNNER_DIR / 'rig-run.log'}")


def runner_stop(_):
    pid = runner_pid()
    if not pid:
        print("runner not running")
        return
    os.killpg(pid, signal.SIGINT)
    for _ in range(30):
        if not runner_pid():
            break
        time.sleep(1)
    else:
        os.killpg(pid, signal.SIGKILL)
    (RUNNER_DIR / ".rig.pid").unlink(missing_ok=True)
    print("runner stopped")


def runner_status(_):
    print(runner_state())


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="rig", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("up", help="start Plane (creates local secrets on first run)").set_defaults(fn=cmd_up)
    sub.add_parser("down", help="stop Plane, keep data").set_defaults(fn=cmd_down)
    r = sub.add_parser("reset", help="stop Plane and wipe its volumes")
    r.add_argument("--yes", action="store_true")
    r.set_defaults(fn=cmd_reset)
    sub.add_parser("bootstrap", help="idempotent admin, workspace, project, states, estimate, API key"
                   ).set_defaults(fn=cmd_bootstrap)
    sub.add_parser("status", help="containers, version, bootstrap, runner").set_defaults(fn=cmd_status)
    sub.add_parser("env", help="print export lines for PLANE_* (eval it)").set_defaults(fn=cmd_env)
    sub.add_parser("playground", help="push API key secret + PLANE_* variables to the playground repo"
                   ).set_defaults(fn=cmd_playground)
    run = sub.add_parser("runner", help="self-hosted Actions runner for the playground repo")
    rs = run.add_subparsers(dest="action", required=True)
    for name, fn in (("register", runner_register), ("start", runner_start),
                     ("stop", runner_stop), ("status", runner_status)):
        rs.add_parser(name).set_defaults(fn=fn)
    args = ap.parse_args()
    try:
        args.fn(args)
    except Failure as e:
        print(f"rig: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
