def shell(template, args):
    """Run a Django snippet in the api container; it prints one `RIG-RESULT <json>` line."""
    script = template.format(args=repr(args))
    r = compose("exec", "-T", "api", "python", "manage.py", "shell", capture=True, stdin=script)
    for line in r.stdout.splitlines():
        if line.startswith("RIG-RESULT "):
            return json.loads(line[len("RIG-RESULT "):])
    raise Failure(f"rig shell snippet gave no result\n{r.stdout}\n{r.stderr}")


def ensure_project(key):
    _, page = api("GET", f"workspaces/{WORKSPACE_SLUG}/projects/", key=key)
    for p in results(page):
        if p["identifier"] == PROJECT_IDENTIFIER:
            return p, False
    _, p = api("POST", f"workspaces/{WORKSPACE_SLUG}/projects/", key=key, body={
        "name": PROJECT_NAME, "identifier": PROJECT_IDENTIFIER,
        "description": "whackagent Plane provider playground (local rig)",
    })
    return p, True


def ensure_features(key, project, log):
    """Cycles (sprints) and modules (milestones) are off on a new project; the API can switch them on."""
    if not (project.get("cycle_view") and project.get("module_view")):
        api("PATCH", f"workspaces/{WORKSPACE_SLUG}/projects/{project['id']}/", key=key,
            body={"cycle_view": True, "module_view": True})
        log.append("cycles and modules enabled")


def ensure_states(key, pid, log):
    base = f"workspaces/{WORKSPACE_SLUG}/projects/{pid}/states/"
    have = {s["name"]: s for s in results(api("GET", base, key=key)[1])}
    for old, new in SEED_RENAMES.items():
        if old in have and new not in have:
            api("PATCH", f"{base}{have[old]['id']}/", key=key, body={"name": new})
            have[new] = have.pop(old)
            log.append(f"state renamed {old} → {new}")
    for seq, (name, group, color) in enumerate(STATES, 1):
        want = {"name": name, "group": group, "color": color, "sequence": seq * 10000}
        if name not in have:
            have[name] = api("POST", base, key=key, body=want)[1]
            log.append(f"state created {name}")
        # POST ignores `sequence` (1.4.2 appends at the end), so a fresh state is patched in place too.
        if any(have[name].get(k) != v for k, v in want.items()):
            have[name] = api("PATCH", f"{base}{have[name]['id']}/", key=key, body=want)[1]
            log.append(f"state updated {name}")
    if not have[DEFAULT_STATE].get("default"):
        api("PATCH", f"{base}{have[DEFAULT_STATE]['id']}/", key=key, body={"default": True})
        log.append(f"default state → {DEFAULT_STATE}")
    for name in SEED_REMOVALS:
        # PATCH default=true through /api/v1 does not clear the old default (1.4.2 serializer gets no
        # project context), so the seed default must be cleared by hand before it can be deleted.
        if name in have and have[name].get("default"):
            api("PATCH", f"{base}{have[name]['id']}/", key=key, body={"default": False})
        if name in have:
            code, body = api("DELETE", f"{base}{have[name]['id']}/", key=key, ok=(204, 400))
            log.append(f"state removed {name}" if code == 204 else f"state {name} kept: {body}")
    rows = sorted(results(api("GET", base, key=key)[1]), key=lambda s: s["sequence"])
    return {s["name"]: s["id"] for s in rows}


SHELL_ESTIMATE = r"""
import json
from plane.db.models import Project, Estimate, EstimatePoint

pid, name, sizes = {args}
created = []
project = Project.objects.get(id=pid)
est = Estimate.objects.filter(project=project).first()
if est is None:
    est = Estimate.objects.create(project=project, workspace=project.workspace, name=name,
                                  type="categories", description="whackagent size", last_used=True)
    created.append("estimate")
