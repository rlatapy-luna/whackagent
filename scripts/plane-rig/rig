#!/usr/bin/env python3
"""Local Plane CE rig for whackagent maintainers (see scripts/plane-rig/README.md).

    scripts/plane-rig/rig up | down | reset --yes | bootstrap | status | env | playground
    scripts/plane-rig/rig runner register | start | stop | status

Maintainer tooling, not shipped behavior. Python 3 stdlib + docker compose (+ gh for `runner`).
Secrets and bootstrap results land in the gitignored scripts/plane-rig/.env.local.
"""
import argparse
import json
import os
import platform
import secrets
import signal
import socket
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
COMPOSE = HERE / "docker-compose.yml"
PLANE_ENV = HERE / "plane.env"
LOCAL_ENV = HERE / ".env.local"

WORKSPACE_SLUG = "whackagent"
WORKSPACE_NAME = "whackagent"
PROJECT_IDENTIFIER = "WA"
PROJECT_NAME = "whackagent playground"
ADMIN_EMAIL = "admin@whackagent.local"
TOKEN_LABEL = "whackagent-rig"

# Contract states (providers/CONTRACT.md) + canceled, in board order. Name → (Plane group, color).
STATES = [
    ("Todo", "unstarted", "#60646C"),
    ("Grilling", "started", "#8E4EC6"),
    ("Grilled", "started", "#3E63DD"),
    ("Coding", "started", "#F59E0B"),
    ("Review", "started", "#E5484D"),
    ("Done", "completed", "#46A758"),
    ("Canceled", "cancelled", "#9AA4BC"),
]
DEFAULT_STATE = "Todo"
# Plane's own seed states that have no contract meaning. Removed when empty, renamed when they map.
SEED_RENAMES = {"Cancelled": "Canceled"}
SEED_REMOVALS = ["Backlog", "In Progress"]

ESTIMATE_NAME = "Size"
SIZES = ["quickwin", "medium", "large"]  # same vocabulary as providers/github/wa-backlog SIZES

PLAYGROUND_REPO = "rlatapy-luna/whackagent-playground-plane"
RUNNER_DIR = Path.home() / "actions-runner-whackagent"
RUNNER_LABEL = "whackagent-plane"


class Failure(Exception):
    pass


# ---------------------------------------------------------------- env files

def read_env(path):
    out = {}
    if path.exists():
        for line in path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    return out


def write_local_env(updates, drop=()):
    env = read_env(LOCAL_ENV)
    for k in drop:
        env.pop(k, None)
    env.update(updates)
    body = "# Local Plane rig secrets and bootstrap results. Gitignored. Never commit.\n"
    body += "".join(f"{k}={v}\n" for k, v in env.items())
    old = os.umask(0o077)
    try:
        LOCAL_ENV.write_text(body)
    finally:
        os.umask(old)
    LOCAL_ENV.chmod(0o600)


def ensure_secrets():
    env = read_env(LOCAL_ENV)
    missing = {k: secrets.token_hex(32) for k in ("SECRET_KEY", "LIVE_SERVER_SECRET_KEY") if not env.get(k)}
    if not env.get("PLANE_ADMIN_PASSWORD"):
        missing["PLANE_ADMIN_PASSWORD"] = secrets.token_hex(12)
    if missing:
        write_local_env(missing)


def plane_url():
    return f"http://localhost:{read_env(PLANE_ENV).get('LISTEN_HTTP_PORT', '8390')}"


# ---------------------------------------------------------------- docker

def compose(*args, check=True, capture=False, stdin=None):
    cmd = ["docker", "compose", "--env-file", str(PLANE_ENV), "--env-file", str(LOCAL_ENV),
           "-f", str(COMPOSE), *args]
    r = subprocess.run(cmd, text=True, input=stdin,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None)
    if check and r.returncode != 0:
        raise Failure(f"docker compose {' '.join(args)} failed ({r.returncode})\n{r.stderr or ''}")
    return r


def docker_ready():
    return subprocess.run(["docker", "info"], capture_output=True).returncode == 0


def wait_http(url, timeout=300):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                if r.status == 200:
                    return
        except (urllib.error.URLError, ConnectionError, socket.timeout):
            pass
        time.sleep(3)
    raise Failure(f"{url} not answering after {timeout}s (see `docker compose logs api proxy`)")


# ---------------------------------------------------------------- REST

def api(method, path, body=None, key=None, ok=(200, 201, 204)):
    key = key or read_env(LOCAL_ENV).get("PLANE_API_KEY")
    url = path if path.startswith("http") else f"{plane_url()}/api/v1/{path.lstrip('/')}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"X-API-Key": key, "Content-Type": "application/json"})
    for attempt in range(5):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                raw = r.read()
                return r.status, (json.loads(raw) if raw else None)
        except urllib.error.HTTPError as e:
            raw = e.read()
            if e.code == 429 and attempt < 4:
                time.sleep(int(e.headers.get("Retry-After") or 15))
                continue
            payload = json.loads(raw) if raw[:1] in (b"{", b"[") else raw.decode(errors="replace")
            if e.code in ok:
                return e.code, payload
            raise Failure(f"{method} {path} → {e.code}: {payload}")
    raise Failure(f"{method} {path} → still rate limited")


def results(payload):
    """List endpoints answer either a bare list or a cursor page {results: [...]}."""
    return payload.get("results", []) if isinstance(payload, dict) else payload


# ---------------------------------------------------------------- commands

def cmd_up(_):
    if not docker_ready():
        raise Failure("docker daemon not answering (start Docker Desktop)")
    ensure_secrets()
    compose("up", "-d", "--quiet-pull")
    wait_http(f"{plane_url()}/api/instances/")
    print(f"Plane up: {plane_url()} (admin console {plane_url()}/god-mode/)")


def cmd_down(_):
    compose("down")
    print("Plane stopped, data kept (volumes).")


def cmd_reset(args):
    if not args.yes:
        raise Failure("reset wipes every Plane volume (workspace, tickets, API key). Rerun with --yes.")
    compose("down", "-v", "--remove-orphans")
    write_local_env({}, drop=("PLANE_API_KEY", "PLANE_PROJECT_ID", "PLANE_WORKSPACE", "PLANE_URL",
                              "PLANE_ADMIN_EMAIL", "PLANE_ESTIMATE_ID"))
    print("Plane stopped and volumes wiped. `rig up` then `rig bootstrap` for a fresh instance.")


