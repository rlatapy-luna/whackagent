# ---------------------------------------------------------------- migration (GitHub board → Plane)

# `migrate` moves a GitHub-board project to Plane: run by /wa-setup reconfigure after `provision --plane-url …` wrote
# the WA_PLANE_* variables. Dry run by default; --apply writes, --push (with --apply) pushes the renamed branches.
# Every step is idempotent per ticket, keyed on what it left behind: card = Plane external id, comment = Plane external
# id, branch = the new ref (local, then remote) and the old remote one gone, issue = marker comment + label + closed.
# The setup PR (config, hooks caller swap, BOARD.md for plane) stays /wa-setup's, like every board file.
MOVED_LABEL = "wa-moved"
MOVED_SOURCE = "whackagent-migrate"  # external_source of every card and comment the migration creates
MOVED_MARKER = "<!-- wa-moved -->"
MIGRATE_FAIL_ENV = "WA_MIGRATE_FAIL_AFTER"  # maintainer test hook: fail after N writes, to prove a rerun resumes
CLOSING = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#(\d+)\b", re.I)
SETUP_PR = [
    "`.whackagent/config.md`: `backlog.provider: plane`",
    "remove `.github/workflows/whackagent-board.yml` (GitHub board caller)",
    "add `.github/workflows/whackagent-board-plane.yml` (Plane caller, `board-plane.yml@hooks-v2`)",
    "`BOARD.md`, PR template sections and pointer blocks rendered for `plane`",
    "`.github/board/wa-backlog` refreshed",
]


def rest_pages(path):
    rows, sep = [], "&" if "?" in path else "?"
    for page in itertools.count(1):
        batch = rest("GET", f"{path}{sep}per_page=100&page={page}") or []
        rows += batch
        if len(batch) < 100:
            return rows


def git_run(*args, env=None, stdin=None):
    proc = subprocess.run(["git", *args], capture_output=True, text=True, input=stdin, env={**os.environ, **(env or {})})
    if proc.returncode != 0:
        raise Failure(f"git {' '.join(args[:2])}: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout.strip()


def local_ref(name):
    proc = subprocess.run(["git", "rev-parse", "--verify", "--quiet", name], capture_output=True, text=True)
    return proc.stdout.strip() or None


def day(stamp):
    return (stamp or "")[:10]


class Migration:
    """One migrate run: source = the GitHub board of the repo variables, target = the provisioned Plane project."""

    def __init__(self, args):
        repo = current_repo()
        variables = repo_variables(repo)
        code = code_settings(variables)
        self.github = GitHubBoard({"repo": repo, **GitHubBoard.settings(repo, variables), **code})
        self.plane = PlaneBoard({"repo": repo, **PlaneBoard.settings(repo, variables), **code})
        target = self.plane.config
        asked = {"--plane-url": (args.plane_url or "").rstrip("/") or None, "--workspace": args.workspace}
        have = {"--plane-url": target["plane_url"], "--workspace": target["workspace"]}
        wrong = [f for f, v in asked.items() if v and v != have[f]]
        if args.project and args.project not in (target["project_key"], target["project_id"]):
            wrong.append("--project")
        if wrong:
            raise Failure(f"{', '.join(wrong)} name another Plane project than the WA_PLANE_* variables "
                          f"({target['project_key']}): run provision --plane-url … --project … for it first", EXIT_USAGE)
        self.repo, self.apply, self.push = repo, args.apply, args.push
        self.writes = 0
        self.fail_after = int(os.environ.get(MIGRATE_FAIL_ENV) or 0)

    def step(self, what):
        """Count one write; the test hook fails the run right after the Nth."""
        self.writes += 1
        note(f"migrate: {what}")
        if self.fail_after and self.writes >= self.fail_after:
            raise Failure(f"injected failure after {self.writes} writes ({MIGRATE_FAIL_ENV}={self.fail_after}): rerun resumes")

    def external_id(self, number):
        return f"github:{self.repo}#{number}"

    # ------------------------------------------------ plan

    def gather(self):
        github, plane, repo = self.github, self.plane, self.repo
        prefix = github.config["branch_prefix"]
        rows = github.tickets()
        moved = {i["number"] for i in rest_pages(f"repos/{repo}/issues?labels={MOVED_LABEL}&state=all")}
        self.cards = {i["external_id"]: i for i in plane.board_items() if i.get("external_source") == MOVED_SOURCE}
        held = claims(github.config)
        plan = {
            "mode": "apply" if self.apply else "dry-run",
            "source": {"repo": repo, "project_url": github.config["project_url"]},
            "target": {k: plane.config[k] for k in ("plane_url", "workspace", "project_key", "project_url")},
            "refused": [],
            "tickets": [],
            "modules": {},
            "sprints": [],
            "dependencies": [],
            "not_copied": {"assignees": {}, "size": {}, "grilled_no_branch": [], "drafts": 0, "ignored": [], "done": 0,
                           "canceled": 0, "not_on_board": []},
            "archive": f"GitHub Project {github.config['project_url']} left untouched: read-only archive",
            "setup_pr": SETUP_PR,
        }
        skipped = plan["not_copied"]
        refused = plan["refused"]
        tickets = []
        for t in rows:
            if t.get("draft"):
                skipped["drafts"] += 1
                continue
            n = t["number"]
            if t["ignored"]:
                skipped["ignored"].append(f"#{n}")
            elif n in moved or self.external_id(n) in self.cards:
                tickets.append(t)  # moved by an earlier run: its remaining steps run again
            elif t["closed"]:
                skipped["canceled" if t["not_planned"] else "done"] += 1
            elif t["state"] in ("todo", "grilled"):
                tickets.append(t)
            elif t["state"] == "done":
                skipped["done"] += 1
            else:
                refused.append({"ticket": f"#{n}", "why": t["state"] or f"column {t['column']!r}, not a whackagent state"})
        for number, phases in sorted(held.items(), key=lambda kv: str(kv[0])):
            refused.append({"ticket": shown(number), "why": f"claim held ({', '.join(c['phase'] for c in phases)})"})
        open_numbers = {t["number"] for t in tickets if not t["closed"]}
        branch_ticket_re = re.compile(rf"{re.escape(prefix)}(\d+)-")
        for pr in rest_pages(f"repos/{repo}/pulls?state=open"):
            match = branch_ticket_re.match(pr["head"]["ref"])
            named = {int(match.group(1))} if match else set()
            named |= {int(x) for x in CLOSING.findall(visible_text(pr.get("body")))}
            for n in sorted(named & open_numbers):
                refused.append({"ticket": f"#{n}", "why": f"open PR #{pr['number']}"})
        board_numbers = {t["number"] for t in rows if not t.get("draft")}
        for issue in rest_pages(f"repos/{repo}/issues?state=open"):
            labels = {l["name"] for l in issue["labels"]}
            if "pull_request" not in issue and issue["number"] not in board_numbers and not labels & {IGNORE_LABEL, SPRINT_LABEL, MOVED_LABEL}:
                skipped["not_on_board"].append(f"#{issue['number']}")
        if refused:  # one row per ticket, every reason
            merged = {}
            for row in refused:
                merged.setdefault(row["ticket"], []).append(row["why"])
            plan["refused"] = [{"ticket": t, "why": "; ".join(dict.fromkeys(whys))} for t, whys in merged.items()]
            self.plan = plan
            return
        self.plan, self.entries = plan, []
        by_state = {i: s for s, i in plane.config["state_ids"].items()}
        for position, t in enumerate(tickets, 1):
            n = t["number"]
            card = self.cards.get(self.external_id(n))
            key = plane.key(card) if card else None
            state = by_state.get(card["state"], "todo") if card else t["state"]
            issue = rest("GET", f"repos/{repo}/issues/{n}")
            comments = [c for c in rest_pages(f"repos/{repo}/issues/{n}/comments")
                        if "<!-- board-check:" not in (c.get("body") or "") and MOVED_MARKER not in (c.get("body") or "")]
            entry = {
                "number": n, "key": key, "state": state, "title": t["title"], "sprint": t["sprint"], "milestone": t["milestone"],
                "issue": issue, "comments": comments, "blocked_by": github.blocked_by(n), "position": position,
                "old_branch": remote_branch(github.config, n), "new_branch": remote_branch(github.config, key) if key else None,
            }
            if t["assignees"]:
                skipped["assignees"][f"#{n}"] = t["assignees"]
            if t["size"]:
                skipped["size"][f"#{n}"] = t["size"]
            if state == "grilled" and not entry["old_branch"] and not entry["new_branch"]:
                skipped["grilled_no_branch"].append(f"#{n}")
            self.entries.append(entry)
        self.plan_modules()
        self.plan_sprints()
        for entry in self.entries:
            self.plan_ticket(entry)
        self.plan_dependencies()
        self.summarize()

    def plan_modules(self):
        titles = {e["milestone"] for e in self.entries if e["milestone"]}
        milestones = self.github.repo_milestones("all")
        want = [m for m in sorted(milestones, key=milestone_rank) if m["state"] == "open" or m["title"] in titles]
        have = {m["title"] for m in self.plane.modules()}
        self.plan["modules"] = {
            "create": [{"title": m["title"], "closed": m["state"] == "closed"} for m in want if m["title"] not in have],
            "existing": [m["title"] for m in want if m["title"] in have],
        }

    def plan_sprints(self):
        self.sprint_parents = {}
        for name in dict.fromkeys(e["sprint"] for e in self.entries if e["sprint"]):
            parents = [i for i in self.github.sprint_issues(name) if i["state"] == "open"]
            roots = self.plane.sprint_roots(name)
            self.plan["sprints"].append({
                "name": name, "plane_root": self.plane.key(roots[0]) if roots else None,
                "close_parents": [f"#{i['number']}" for i in parents],
            })
            self.sprint_parents[name] = [i["number"] for i in parents]

    def ticket_url(self, entry):
        return self.plane.ticket_url(entry["key"]) if entry["key"] else None

    def plan_ticket(self, entry):
        config = self.github.config
        prefix, tasks = config["branch_prefix"], config["tasks_path"].rstrip("/")
        posted = set()
        if entry["key"]:
            path = f"{self.plane.base()}/work-items/{self.cards[self.external_id(entry['number'])]['id']}/comments/"
            posted = {c.get("external_id") for c in plane_all(self.plane.config["plane_url"], path) if c.get("external_source") == MOVED_SOURCE}
        todo_comments = [c for c in entry["comments"] if self.comment_id(entry, c) not in posted]
        branch = None
        old, new = entry["old_branch"], entry["new_branch"]
        if old or new:
            # slug after the id: wa/12-login → login, wa/MIG-3-login → login
            slug = old.removeprefix(prefix).split("-", 1)[1] if old else new.removeprefix(prefix).split("-", 2)[2]
            to = f"{prefix}{entry['key'] or self.plane.config['project_key'] + '-?'}-{slug}"
            if new:
                status = "delete old branch" if old else "done"
            elif entry["key"] and local_ref(f"refs/heads/{to}"):
                status = "push new branch, delete old one"
            else:
                status = "commit (spec commits squashed, task file renamed), then push new branch and delete old one"
            branch = {"from": old, "to": to, "status": status,
                      "task_file": {"from": f"{tasks}/{entry['number']}-{slug}.md", "to": f"{tasks}/{to.removeprefix(prefix)}.md"}}
        issue = entry["issue"]
        closed = issue["state"] == "closed" and MOVED_LABEL in [l["name"] for l in issue["labels"]]
        entry["plan"] = {
            "source": f"#{entry['number']}", "title": entry["title"], "state": entry["state"], "position": entry["position"],
            "sprint": entry["sprint"], "milestone": entry["milestone"], "comments": len(entry["comments"]),
            "blocked_by": [f"#{b['number']}" for b in entry["blocked_by"]],
            "card": entry["key"] or "create",
            "comments_to_post": len(todo_comments),
            "branch": branch,
            "issue": "done" if closed else "close as not planned, link comment, label wa-moved",
        }
        entry["todo_comments"] = todo_comments
        self.plan["tickets"].append(entry["plan"])

    def plan_dependencies(self):
        moved = {e["number"] for e in self.entries}
        for entry in self.entries:
            if not entry["blocked_by"]:
                continue
            keep = [b["number"] for b in entry["blocked_by"] if b["number"] in moved]
            dropped = [f"#{b['number']} ({b['state']}, not moved)" for b in entry["blocked_by"] if b["number"] not in moved]
            self.plan["dependencies"].append({"ticket": f"#{entry['number']}", "on": [f"#{n}" for n in keep], "dropped": dropped})

    def summarize(self):
        tickets = self.plan["tickets"]
        branches = [t["branch"] for t in tickets if t["branch"]]
        self.plan["summary"] = {
            "cards_to_create": sum(t["card"] == "create" for t in tickets),
            "comments_to_post": sum(t["comments_to_post"] for t in tickets),
            "branches_to_rename": sum(b["status"] != "done" for b in branches),
            "issues_to_close": sum(t["issue"] != "done" for t in tickets) + sum(len(s["close_parents"]) for s in self.plan["sprints"]),
            "modules_to_create": len(self.plan["modules"]["create"]),
        }

    def comment_id(self, entry, comment):
        return f"{self.external_id(entry['number'])}/comment/{comment['id']}"

    # ------------------------------------------------ apply

    def run(self):
        self.last = float("-inf")  # sort_order of the previous migrated card
        self.ensure_modules()
        for entry in self.entries:
            self.ensure_card(entry)
            self.ensure_order(entry)
            self.ensure_fields(entry)
            self.ensure_comments(entry)
            self.ensure_branch(entry)
            self.close_issue(entry["number"], entry["key"], f"ticket is now [{entry['key']}]({self.ticket_url(entry)})")
            entry["plan"]["card"] = entry["key"]
        self.ensure_dependencies()
        for sprint in self.plan["sprints"]:
            roots = self.plane.sprint_roots(sprint["name"])
            root = self.plane.key(roots[0]) if roots else None
            sprint["plane_root"] = root
            for number in self.sprint_parents[sprint["name"]]:
                link = f"sprint `{sprint['name']}` is now Plane sprint root [{root}]({self.plane.ticket_url(root)}) and cycle `{sprint['name']}`"
                self.close_issue(number, root, link)
        self.plan["result"] = {"writes": self.writes, "pushed": self.push}

    def ensure_modules(self):
        for module in self.plan["modules"]["create"]:
            if module["title"] in {m["title"] for m in self.plane.modules()}:
                continue
            body = {"name": module["title"], **({"status": "completed"} if module["closed"] else {})}
            self.plane.api("POST", f"{self.plane.base()}/modules/", body, missing=(400,))  # 400: name taken by a racing run
            self.plane.module_rows = self.plane.module_items = None
            self.step(f"module {module['title']}")

    def ensure_card(self, entry):
        if entry["key"]:
            return
        plane, issue = self.plane, entry["issue"]
        external = self.external_id(entry["number"])
        if not hasattr(self, "bottom"):
            self.bottom = max([i["sort_order"] for i in plane.board_items()] or [0])
        self.bottom = max(self.bottom, self.last) + PLANE_STEP
        order = self.bottom  # honoured in an empty column only: ensure_order fixes the rest
        text = (issue.get("body") or "").strip()
        footer = f"↪ Moved from GitHub [{self.repo}#{entry['number']}]({issue['html_url']}), opened by @{issue['user']['login']} on {day(issue['created_at'])}."
        body = {
            "name": entry["title"], "description_html": comment_html(f"{text}\n\n{footer}" if text else footer),
            "state": plane.config["state_ids"][entry["state"]], "sort_order": order,
            "external_source": MOVED_SOURCE, "external_id": external,
        }
        item = plane.api("POST", f"{plane.base()}/work-items/", body, missing=(409,))
        if item is None:  # 409: a racing run created it
            item = plane.api("GET", f"{plane.base()}/work-items/?external_id={quote(external, safe='')}&external_source={MOVED_SOURCE}")
        plane.remember(item)
        self.cards[external] = item
        entry["key"] = plane.key(item)
        self.step(f"#{entry['number']} → card {entry['key']} ({entry['state']})")

    def ensure_order(self, entry):
        """Migrated cards keep the GitHub board order: each one below the previous (Plane drops a new card at the
        bottom of its own column, so a Grilled card would land among the Todo ones). Checked on every run."""
        item = self.plane.item(entry["key"])
        if item["sort_order"] <= self.last:
            value = self.last + PLANE_STEP
            self.plane.remember(self.plane.api("PATCH", f"{self.plane.base()}/work-items/{item['id']}/", {"sort_order": value}))
            self.step(f"{entry['key']} placed after the previous ticket")
        self.last = self.plane.item(entry["key"])["sort_order"]

    def ensure_fields(self, entry):
        plane, key = self.plane, entry["key"]
        item = plane.item(key)
        if (plane.milestone_of(item) or None) != (entry["milestone"] or None) and entry["milestone"]:
            plane.set_milestone(key, entry["milestone"])
            self.step(f"{key} milestone {entry['milestone']}")
        if entry["sprint"] and plane.sprint_of(item) != entry["sprint"]:
            plane.set_sprint(key, entry["sprint"])
            self.step(f"{key} sprint {entry['sprint']}")

    def ensure_comments(self, entry):
        plane = self.plane
        path = f"{plane.base()}/work-items/{plane.item(entry['key'])['id']}/comments/"
        posted = {c.get("external_id") for c in plane_all(plane.config["plane_url"], path) if c.get("external_source") == MOVED_SOURCE}
        for comment in entry["comments"]:
            external = self.comment_id(entry, comment)
            if external in posted:
                continue
            header = f"**@{comment['user']['login']}** on GitHub, {day(comment['created_at'])} (originally posted there):"
            plane.api("POST", path, {
                "comment_html": comment_html(f"{header}\n\n{comment.get('body') or ''}"),
                "created_at": comment["created_at"], "external_source": MOVED_SOURCE, "external_id": external,
            }, missing=(409,))
            self.step(f"{entry['key']} comment {comment['id']}")
        entry["plan"]["comments_to_post"] = 0

    def fork_point(self, tip):
        """Base the ticket branch forked from: the remote branch (not a ticket branch) closest to its tip."""
        prefix = self.github.config["branch_prefix"]
        default = rest("GET", f"repos/{self.repo}")["default_branch"]
        best = None
        for ref in git_run("for-each-ref", "--format=%(refname)", "refs/remotes/origin/").splitlines():
            name = ref.removeprefix("refs/remotes/origin/")
            if name == "HEAD" or name.startswith(prefix):
                continue
            ahead = int(git_run("rev-list", "--count", f"{ref}..{tip}"))
            if ahead and (best is None or (ahead, name != default) < best[:2]):
                best = (ahead, name != default, ref)
        if not best:
            raise Failure(f"no base branch found for {tip[:7]}")
        return git_run("merge-base", best[2], tip)

    def moved_tree(self, entry, tip, slug):
        """Tip's tree with the task file renamed to the new id and its `issue:` set to the card key."""
        tasks = self.github.config["tasks_path"].rstrip("/")
        names = git_run("ls-tree", "--name-only", tip, f"{tasks}/").splitlines()
        old = next((p for p in names if p == f"{tasks}/{entry['number']}-{slug}.md"), None)
        old = old or next((p for p in names if re.fullmatch(rf"{re.escape(tasks)}/{entry['number']}-.+\.md", p)), None)
        if not old:
            note(f"migrate: #{entry['number']}: no task file on its branch, branch renamed without one")
            return git_run("rev-parse", f"{tip}^{{tree}}"), None
        new = f"{tasks}/{entry['key']}-{old.rsplit('/', 1)[-1].split('-', 1)[1]}"
        text = git_run("show", f"{tip}:{old}") + "\n"
        text = re.sub(r"^issue:.*$", f"issue: {entry['key']}", text, count=1, flags=re.M)
        with tempfile.TemporaryDirectory() as tmp:
            env = {"GIT_INDEX_FILE": str(Path(tmp, "index"))}
            git_run("read-tree", tip, env=env)
            git_run("rm", "--cached", "--quiet", old, env=env)
            blob = git_run("hash-object", "-w", "--stdin", stdin=text)
            git_run("update-index", "--add", "--cacheinfo", f"100644,{blob},{new}", env=env)
            return git_run("write-tree", env=env), new

    def ensure_branch(self, entry):
        """Renamed ticket branch: one commit (the ticket's spec commits squashed, task file moved) on the old branch's
        fork point, so the ticket range (`task: grill <id>`) starts there. Local first; pushed, old branch deleted,
        only with --push."""
        branch = entry["plan"]["branch"]
        if not branch or branch["status"] == "done":
            return
        prefix = self.github.config["branch_prefix"]
        old = entry["old_branch"]
        slug = old.removeprefix(prefix).split("-", 1)[1]
        new = f"{prefix}{entry['key']}-{slug}"
        branch["to"] = new
        if not entry["new_branch"] and not local_ref(f"refs/heads/{new}"):
            git_run("fetch", "--quiet", "origin")
            tip = git_run("rev-parse", f"refs/remotes/origin/{old}")
            tree, moved = self.moved_tree(entry, tip, slug)
            branch["task_file"]["to"] = moved
            base = self.fork_point(tip)
            subjects = git_run("log", "--format=- %s", f"{base}..{tip}")
            message = (f"task: grill {entry['key']} {slug}\n\nMoved from GitHub #{entry['number']} (branch {old} at {tip[:7]}) "
                       f"to Plane {entry['key']}: its commits squashed, task file renamed, issue: {entry['key']}.\n\n{subjects}\n")
            sha = git_run("commit-tree", tree, "-p", base, stdin=message)
            git_run("update-ref", f"refs/heads/{new}", sha, "")
            self.step(f"{old} → {new} committed locally ({sha[:7]})")
        if not self.push:
            branch["status"] = ("committed locally: " if not entry["new_branch"] else "") + "push and delete old branch on yes (--push)"
            return
        if not entry["new_branch"]:
            git_run("push", "--quiet", "origin", f"refs/heads/{new}:refs/heads/{new}")
            entry["new_branch"] = new
            self.step(f"{new} pushed")
        if remote_branch(self.github.config, entry["number"]):
            git_run("push", "--quiet", "origin", "--delete", old)
            self.step(f"{old} deleted")
        branch["status"] = "done"

    def ensure_label(self):
        code, _ = rest("GET", f"repos/{self.repo}/labels/{MOVED_LABEL}", check=False)
        if code != 0:
            rest("POST", f"repos/{self.repo}/labels", {"name": MOVED_LABEL, "color": "9AA4BC",
                                                      "description": "moved to the Plane board: closed here, worked there"})
            self.step(f"label {MOVED_LABEL}")

    def close_issue(self, number, key, text):
        """GitHub issue closed as not planned, with a marker comment linking its Plane card and label wa-moved."""
        repo = self.repo
        if not getattr(self, "labeled", False):
            self.ensure_label()
            self.labeled = True
        comments = rest_pages(f"repos/{repo}/issues/{number}/comments")
        if not any(MOVED_MARKER in (c.get("body") or "") for c in comments):
            rest("POST", f"repos/{repo}/issues/{number}/comments", {"body": f"{MOVED_MARKER}\n➡️ **moved to Plane** — {text}. "
                 f"Closed here as not planned; the GitHub Project keeps it as a read-only archive."})
            self.step(f"#{number} link comment → {key}")
        issue = rest("GET", f"repos/{repo}/issues/{number}")
        if MOVED_LABEL not in [l["name"] for l in issue["labels"]]:
            rest("POST", f"repos/{repo}/issues/{number}/labels", {"labels": [MOVED_LABEL]})
            self.step(f"#{number} labeled {MOVED_LABEL}")
        if issue["state"] != "closed":
            rest("PATCH", f"repos/{repo}/issues/{number}", {"state": "closed", "state_reason": "not_planned"})
            self.step(f"#{number} closed as not planned")

    def ensure_dependencies(self):
        keys = {e["number"]: e["key"] for e in self.entries}
        for row in self.plan["dependencies"]:
            number = int(row["ticket"].lstrip("#"))
            on = [keys[int(n.lstrip("#"))] for n in row["on"]]
            if on:
                added, _ = self.plane.depend(keys[number], on)
                if added:
                    self.step(f"{keys[number]} blocked by {', '.join(added)}")
            row["plane"] = {"ticket": keys[number], "on": on}


def op_migrate(args):
    """GitHub board → Plane, dry run unless --apply (providers/plane/README.md → Migration)."""
    if args.push and not args.apply:
        raise Failure("--push goes with --apply (it pushes what the apply committed)", EXIT_USAGE)
    migration = Migration(args)
    migration.gather()
    plan = migration.plan
    if plan["refused"]:
        emit(plan)
        names = ", ".join(f"{r['ticket']} ({r['why']})" for r in plan["refused"])
        raise Failure(f"migration refused, in-flight work: {names} — land, release or cancel it first", EXIT_WRONG_STATE)
    if not args.apply:
        emit(plan)
        return
    try:
        migration.run()
    except Failure as failure:
        plan["failed"] = str(failure)
        emit(plan)
        raise
    emit(plan)


# ---------------------------------------------------------------- pull requests


SHOTS_START, SHOTS_END = "<!-- wa-screenshots -->", "<!-- /wa-screenshots -->"
SHOTS_SECTION = re.compile(r"<!-- wa-screenshots(?: sha=(\w+))? -->.*?" + re.escape(SHOTS_END), re.S)
SHOT_IMG = re.compile(r'<img src="(https://[^"]+)"[^>]*? alt="([^"]+)"')
OLD_SHOT_IMG = re.compile(r'<img src="(https://[^"]+)"[^>]*><br><sub>([^<]+)</sub>')  # before alt captions
MD_IMG = re.compile(r"!\[[^\]]*\]\((https://[^)]+)\)")


def with_section(body, section):
    """Body with its screenshots section replaced by `section` (appended when absent; "" removes it)."""
    if SHOTS_SECTION.search(body):
        return SHOTS_SECTION.sub(lambda _: section, body, count=1) if section else SHOTS_SECTION.sub("", body).rstrip() + "\n"
    return body.rstrip() + "\n\n" + section + "\n" if section else body


def section_images(section):
    """{caption: url} of a screenshots section; sections written before alt captions name them in <sub>."""
    return {alt: url for url, alt in SHOT_IMG.findall(section) or OLD_SHOT_IMG.findall(section)}


def pr_body(repo, pr):
    return rest("GET", f"repos/{repo}/pulls/{pr}")["body"] or ""


def upload_attach(repo, pr, body, files):
    """`gh pr edit --attach` (gh >= 2.102): the body's `![..](./file)` refs become user-attachments URLs.
    Returns (URLs in file order or None when any upload failed, whether the body was edited)."""
    if "--attach" not in gh(["pr", "edit", "--help"], check=False).stdout:
        return None, False
    with tempfile.TemporaryDirectory() as tmp:
        names = []
        for index, path in enumerate(files):
            names.append(f"wa-shot-{index}{Path(path).suffix.lower()}")
            shutil.copyfile(path, Path(tmp, names[-1]))
        refs = "\n".join(f"![{Path(path).stem}](./{name})" for path, name in zip(files, names))
        Path(tmp, "body.md").write_text(with_section(body, f"{SHOTS_START}\n{refs}\n{SHOTS_END}"))
        attach = [arg for name in names for arg in ("--attach", f"./{name}")]
        proc = subprocess.run(
            ["gh", "pr", "edit", str(pr), "--repo", repo, "--body-file", "body.md", *attach],
            cwd=tmp,
            capture_output=True,
            text=True,
        )
    now = SHOTS_SECTION.search(pr_body(repo, pr))
    urls = MD_IMG.findall(now.group(0)) if now else []
    return (urls if proc.returncode == 0 and len(urls) == len(files) else None), True


def upload_gh_image(repo, files):
    proc = subprocess.run(["gh", "image", "--repo", repo, *files], capture_output=True, text=True)
    urls = MD_IMG.findall(proc.stdout)
    return urls if proc.returncode == 0 and len(urls) == len(files) else None


def shots_section(shots, sha, width):
    """Single shots in one row; `<caption>.before` / `<caption>.after` pairs in a Before | After table."""
    img = lambda key: f'<img src="{shots[key]}" width="{width}" alt="{key}">' if key in shots else "—"
    pairs = list(dict.fromkeys(key.rsplit(".", 1)[0] for key in shots if key.endswith((".before", ".after"))))
    singles = [key for key in shots if not key.endswith((".before", ".after"))]
    parts = []
    if singles:
        cells = "".join(f'<td align="center">{img(key)}<br><sub>{key}</sub></td>' for key in singles)
        parts.append(f"<table><tr>{cells}</tr></table>")
    if pairs:
        rows = "".join(
            f'<tr><td><sub>{key}</sub></td><td align="center">{img(key + ".before")}</td>'
            f'<td align="center">{img(key + ".after")}</td></tr>'
            for key in pairs
        )
        parts.append(f"<table><tr><th></th><th>Before</th><th>After</th></tr>{rows}</table>")
    start = f"<!-- wa-screenshots sha={sha} -->" if sha else SHOTS_START
    return f"{start}\n## Screenshots\n\n" + "\n\n".join(parts) + f"\n{SHOTS_END}"


def op_screenshots(args):
    """Upload screenshots (GitHub user-attachments) and show them in PR <pr>'s body; no image = read back.

    Never pushed to a branch: attachments live outside git, like images pasted in the web UI.
    Upload: `gh pr edit --attach` (gh >= 2.102), else the `gh image` extension. An image given as
    `<caption>=<https url>` is already uploaded (browser fallback when neither gets an upload token)
    and kept as is. File stem = caption; `<caption>.before` / `<caption>.after` = a changed screen.
    Rerun replaces the section only, rest of the body untouched; --keep merges the current images;
    --clear removes the section. Body re-read before each write: edits made meanwhile survive.
    """
    config = load()
    repo = config["repo"]
    body = pr_body(repo, args.pr)
    current = SHOTS_SECTION.search(body)
    kept = section_images(current.group(0)) if current else {}
    if args.clear:
        if args.images:
            raise Failure("--clear takes no image", EXIT_USAGE)
        if current:
            rest("PATCH", f"repos/{repo}/pulls/{args.pr}", {"body": with_section(pr_body(repo, args.pr), "")})
        emit({"pr": args.pr, "cleared": bool(current)})
        return
    if not args.images:
        emit({"pr": args.pr, "sha": current.group(1) if current else None, "images": kept})
        return
    shots = [image.split("=", 1) if re.match(r"[^=/]+=https://", image) else [Path(image).stem, image] for image in args.images]
    files = [path for _, path in shots if not path.startswith("https://")]
    uploaded = []
    if files:
        uploaded, edited = upload_attach(repo, args.pr, body, files)
        uploaded = uploaded or upload_gh_image(repo, files)
        if not uploaded:
            if edited:  # --attach wrote its refs into the body: put the previous section back
                restored = with_section(pr_body(repo, args.pr), current.group(0) if current else "")
                rest("PATCH", f"repos/{repo}/pulls/{args.pr}", {"body": restored})
            raise Failure("upload failed: gh pr edit --attach (gh >= 2.102) and gh image (drogers0/gh-image) both failed")
    uploaded = iter(uploaded)
    urls = {caption: path if path.startswith("https://") else next(uploaded) for caption, path in shots}
    images = {**kept, **urls} if args.keep else urls
    section = shots_section(images, args.sha, args.width)
    rest("PATCH", f"repos/{repo}/pulls/{args.pr}", {"body": with_section(pr_body(repo, args.pr), section)})
    emit({"pr": args.pr, "sha": args.sha, "images": images})


def stack_view(config, number):
    stack = rest("GET", f"repos/{config['repo']}/stacks/{number}")
    pattern = re.compile(re.escape(config["branch_prefix"]) + rf"({TICKET_ID.pattern})-")
    prs = []
    for pr in stack["pull_requests"]:
        ticket = pattern.match(pr["head"]["ref"])
        prs.append(
            {
                "pr": pr["number"],
                "ticket": ticket_id(ticket.group(1)) if ticket else None,
                "branch": pr["head"]["ref"],
                "state": "merged" if pr.get("merged_at") else pr["state"],
                "draft": pr.get("draft", False),
            }
        )
    return {"stack": stack["number"], "base": stack["base"]["ref"], "open": stack["open"], "prs": prs}


def shared_group(board, pr, blocker):
    """Sprint or track both tickets belong to, or None: only tickets of one body of work stack."""
    config = board.config
    pattern = re.compile(re.escape(config["branch_prefix"]) + rf"({TICKET_ID.pattern})-")
    numbers = [pattern.match(p["head"]["ref"]) for p in (pr, blocker)]
    if not all(numbers):
        raise Failure("only ticket PRs stack", EXIT_WRONG_STATE)
    mine, theirs = (find(board, ticket_id(n.group(1)), with_owners=False) for n in numbers)
    if mine["sprint"] and mine["sprint"] == theirs["sprint"]:
        return f"sprint {mine['sprint']}"
    if mine["milestone"] in config.get("tracks", []) and mine["milestone"] == theirs["milestone"]:
        return f"track {mine['milestone']}"
    return None


def op_stack(args):
    """Show the GitHub stack PR <pr> belongs to, or with --on put <pr> on top of <blocker>'s stack.

    GitHub stacks are linear: <pr> must target <blocker>'s branch and <blocker> must be the top.
    Both tickets must share a sprint or a track.
    """
    board = open_board()
    config = board.config
    repo = config["repo"]
    pr = rest("GET", f"repos/{repo}/pulls/{args.pr}")
    if args.on is None:
        if not pr.get("stack"):
            emit({"pr": args.pr, "stack": None})
            return
        emit(stack_view(config, pr["stack"]["number"]))
        return
    blocker = rest("GET", f"repos/{repo}/pulls/{args.on}")
    if pr["base"]["ref"] != blocker["head"]["ref"]:
        raise Failure(f"#{args.pr} targets {pr['base']['ref']}, not #{args.on}'s branch {blocker['head']['ref']}", EXIT_WRONG_STATE)
    below, mine = blocker.get("stack"), pr.get("stack")
    if mine:
        if below and mine["number"] == below["number"]:
            emit(stack_view(config, mine["number"]))
            return
        raise Failure(f"#{args.pr} already in stack {mine['number']}", EXIT_WRONG_STATE)
    if not shared_group(board, pr, blocker):
        raise Failure(f"#{args.pr} and #{args.on} share no sprint or track: no stack, PR goes on base", EXIT_WRONG_STATE)
    if not below:
        stack = rest("POST", f"repos/{repo}/stacks", {"pull_requests": [args.on, args.pr]})
    elif below["position"] == below["size"]:
        stack = rest("POST", f"repos/{repo}/stacks/{below['number']}/add", {"pull_requests": [args.pr]})
    else:
        raise Failure(f"#{args.on} is not the top of stack {below['number']}: stacks are linear", EXIT_WRONG_STATE)
    emit(stack_view(config, stack["number"]))


def op_merge(args):
    """Merge PR <pr> alone through the async merge API, the only one GitHub accepts for a stacked PR.

    A stack merge also lands every open PR below, so a PR with open PRs below it is refused.
    """
    config = load()
    repo = config["repo"]
    pr = rest("GET", f"repos/{repo}/pulls/{args.pr}")
    if pr.get("merged"):
        emit({"pr": args.pr, "status": "merged", "sha": pr.get("merge_commit_sha")})
        return
    if pr["state"] != "open" or pr.get("draft"):
        raise Failure(f"#{args.pr} is {'draft' if pr.get('draft') else pr['state']}", EXIT_WRONG_STATE)
    if pr.get("stack"):
        prs = stack_view(config, pr["stack"]["number"])["prs"]
        below = [p["pr"] for p in prs[: pr["stack"]["position"] - 1] if p["state"] == "open"]
        if below:
            raise Failure(f"#{below[-1]} below it in stack {pr['stack']['number']} merges first", EXIT_WRONG_STATE)
    path = f"repos/{repo}/pulls/{args.pr}/merge-async"
    code, result = rest("PUT", path, {"merge_method": args.method, "sha": pr["head"]["sha"]}, check=False)
    result = result or {}
    uuid = (result.get("details") or {}).get("uuid")
    if code != 0 and not uuid:
        raise Failure(f"merge #{args.pr}: {result.get('message') or result}")
    deadline = dt.datetime.now() + dt.timedelta(seconds=args.timeout)
    while result.get("status") == "pending" or (code != 0 and uuid):
        if dt.datetime.now() > deadline:
            raise Failure(f"merge #{args.pr} still pending after {args.timeout}s (request {uuid})")
        time.sleep(2)
        code, result = 0, rest("GET", f"{path}/{uuid}")
    details = result.get("details") or {}
    if result.get("status") == "failed":
        raise Failure(f"merge #{args.pr} refused: {details.get('message') or result}", EXIT_WRONG_STATE)
    emit({"pr": args.pr, "status": result.get("status"), "sha": details.get("sha") or details.get("oid")})


# ---------------------------------------------------------------- hooks (board tools other than GitHub)

# `hook` = the board hooks of a board tool that is not GitHub (Plane): run by the reusable workflow
# .github/workflows/board-plane.yml on a self-hosted runner, or by hand with --event/--payload to replay a
# recorded event. Same rules as the JavaScript of board.yml for the GitHub board, which stays as it is. One
# handler per event name (push, pull_request); an event without one is a no-op. Each returns {action, reason}
# and logs one line. A board adapter the hooks drive also provides: linked_tickets(text) (card links in a PR
# body), link_pr / linked_prs (PR links on the card), open_sprint(name), sprint_parent(number),
# sprint_complete(root), close_sprint(root, why).


def spec_section(text, heading):
    """Body of `## <heading>` without HTML comments, trimmed: "" when missing or empty. Same as section() in
    board.yml, so a task file counts as grilled on both boards alike."""
    parts = re.split(rf"^## {re.escape(heading)}\s*$", text, maxsplit=1, flags=re.M)
    if len(parts) < 2:
        return ""
    body = re.split(r"^## ", parts[1], maxsplit=1, flags=re.M)[0]
    return re.sub(r"<!--[\s\S]*?-->", "", body).strip()


def branch_ticket(board, branch):
    """Ticket id of a ticket branch <prefix><id>-<slug>, or None (sprint branch, other branch, other board's id)."""
    prefix = board.config["branch_prefix"]
    match = re.match(rf"{re.escape(prefix)}({TICKET_ID.pattern})-", branch)
    if not match:
        return None
    number = ticket_id(match.group(1))
    try:
        board.check_id(number)
    except Failure:
        return None
    return number


def task_file_at(config, number, sha):
    """(path, text) of the ticket's task file `{tasks}/<id>-*.md` in commit <sha>, or None. Frontmatter
    `issue:` must name the ticket, as in board.yml."""
    tasks = config["tasks_path"].rstrip("/")
    code, listing = rest("GET", f"repos/{config['repo']}/contents/{quote(tasks)}?ref={sha}", check=False)
    if code != 0 or not isinstance(listing, list):
        return None
    name = re.compile(rf"^{re.escape(str(number))}-.*\.md$")
    found = next((f for f in listing if name.match(f["name"])), None)
    if not found:
        return None
    data = rest("GET", f"repos/{config['repo']}/contents/{quote(found['path'])}?ref={sha}")
    text = base64.b64decode(data["content"]).decode("utf-8", "replace")
    if not re.search(rf"^issue:\s*#?{re.escape(str(number))}\s*$", text, re.M):
        note(f"{found['path']}: frontmatter issue: does not match {shown(number)}")
        return None
    return found["path"], text


def drop_claim(config, number, phase):
    """Delete a claim ref; already gone is fine. The hook never touches assignees (same as board.yml)."""
    rest("DELETE", f"repos/{config['repo']}/git/refs/{CLAIM_NAMESPACE}/{number}/{phase}", check=False)


def hook_push(board, payload):
    """Task file with a non-empty `## Acceptance criteria` pushed on its ticket branch → grilled, from todo
    or grilling, and the grilling claim dropped. Anything else: no-op."""
    config = board.config
    if payload.get("deleted"):
        return {"action": "none", "reason": "branch deleted"}
    branch = payload.get("ref", "").removeprefix("refs/heads/")
    number = branch_ticket(board, branch)
    if number is None:
        return {"action": "none", "reason": f"{branch} is not a ticket branch ({config['branch_prefix']}<id>-<slug>)"}
    sha = payload["after"]
    task = task_file_at(config, number, sha)
    if not task:
        return {"ticket": number, "action": "none", "reason": f"no task file {config['tasks_path']}/{number}-*.md at {sha[:7]}"}
    path, text = task
    if not spec_section(text, "Acceptance criteria"):
        return {"ticket": number, "action": "none", "reason": f"{path}: Acceptance criteria empty, grill not finished"}
    try:
        ticket = board.get(number)
    except Failure as failure:  # sprint root, wa-ignore, unknown card: nothing to move
        return {"ticket": number, "action": "none", "reason": str(failure)}
    if ticket["state"] not in ("todo", "grilling"):
        where = ticket["state"] or f"column {ticket['column']!r}"
        return {"ticket": number, "action": "none", "reason": f"card in {where}, not todo/grilling"}
    board.set_state(ticket, "grilled")
    drop_claim(config, number, "grilling")
    # sha permalink: the branch is deleted on merge, the commit stays
    url = f"{os.environ.get('GITHUB_SERVER_URL', 'https://github.com')}/{config['repo']}/blob/{sha}/{quote(path)}"
    # link text plain: comment_html keeps `code` literal, so a code span inside [text] would break the link
    board.comment(number, f"✅ **grilled** — spec [{path.rsplit('/', 1)[-1]}]({url}) on `{branch}`")
    return {"ticket": number, "action": f"{ticket['state']} → grilled", "reason": f"spec {path} at {sha[:7]}"}


def claim_held(config, number, phase):
    return any(c["phase"] == phase for c in claims(config, number))


def server_url():
    return os.environ.get("GITHUB_SERVER_URL", "https://github.com")


def visible_text(body):
    """PR body as a reader sees it: no run report, HTML comments or code (same filter as ticketOf in board.yml)."""
    text = re.sub(r"<!-- wa-report -->[\s\S]*?<!-- /wa-report -->", "", body or "")
    text = re.sub(r"<!--[\s\S]*?-->", "", text)
    text = re.sub(r"```[\s\S]*?```", "", text)
    return re.sub(r"`[^`\n]*`", "", text)


def report_on_pr(config, pr, kind, text):
    """Contract break reported once on the PR, keyed by a hidden marker (same comment as report() in board.yml)."""
    marker = f"<!-- board-check:{kind} -->"
    comments = rest("GET", f"repos/{config['repo']}/issues/{pr}/comments?per_page=100") or []
    if any(marker in (c.get("body") or "") for c in comments):
        return
    contract = f"{server_url()}/{config['repo']}/blob/HEAD/BOARD.md"
    body = f"{marker}\n⚠️ **board check** — {text}. See [BOARD.md]({contract}); this check only reports, it never moves cards."
    rest("POST", f"repos/{config['repo']}/issues/{pr}/comments", {"body": body})


def pr_ticket(board, pr):
    """(ticket, why) of a PR: its <prefix><id>-<slug> branch first, else the one card link in its body (a PR from a
    cloud agent naming its own branch). A sprint PR lands a sprint, not a ticket. Several card links → reported
    on the PR, no ticket (a PR links exactly one)."""
    config = board.config
    head = pr["head"]["ref"]
    if config["sprint_prefix"] and head.startswith(config["sprint_prefix"]):
        return None, f"sprint PR ({head})"
    number = branch_ticket(board, head)
    if number is not None:
        try:
            board.item(number)  # another project's key, or no such card: the body may still name the ticket
            return number, "branch"
        except Failure:
            pass
    found = board.linked_tickets(visible_text(pr.get("body")))
    if len(found) > 1:
        report_on_pr(config, pr["number"], "several-tickets", f"#{pr['number']} links {', '.join(found)}: a PR links exactly one ticket")
        return None, f"body links {', '.join(found)}: a PR links exactly one ticket"
    if found:
        return found[0], "card link in body"
    return None, f"{head} is not a ticket branch and the body links no card"


def feedback_rounds(text):
    """`### ` blocks of `## Feedback`: [(first line, last line, text)], 1-based (feedbackRounds() in board.yml)."""
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if re.match(r"^## Feedback\s*$", line)), None)
    if start is None:
        return []
    rounds = []
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("## "):
            break
        if lines[i].startswith("### "):
            rounds.append([i + 1, i + 1])
        elif rounds and lines[i].strip():
            rounds[-1][1] = i + 1
    return [(a, b, "\n".join(lines[a - 1:b])) for a, b in rounds]


def new_feedback(config, number, before, after):
    """[(path, first, last, permalink)] of the `## Feedback` rounds new since <before>; a force push that dropped
    <before> → the last round only (newFeedback() in board.yml)."""
    task = task_file_at(config, number, after)
    rounds = feedback_rounds(task[1]) if task else []
    if not rounds:
        return []
    code, _ = rest("GET", f"repos/{config['repo']}/commits/{before}", check=False)
    if code != 0:
        rounds = rounds[-1:]
    else:
        previous = task_file_at(config, number, before)
        old = {r[2] for r in feedback_rounds(previous[1])} if previous else set()
        rounds = [r for r in rounds if r[2] not in old]
    path = task[0]
    return [(path, a, b, f"{server_url()}/{config['repo']}/blob/{after}/{quote(path)}?plain=1#L{a}-L{b}") for a, b, _ in rounds]


def run_report(body):
    """Run report of the PR body (between <!-- wa-report --> markers), as plain Markdown for a card comment."""
    match = re.search(r"<!-- wa-report -->([\s\S]*?)<!-- /wa-report -->", body or "")
    if not match:
        return ""
    text = re.sub(r"<summary>(.*?)</summary>", r"**\1**\n", match.group(1))
    return re.sub(r"</?details>", "", text).strip()


def hook_pull_request(board, payload):
    """PR events → review / done / grilled, the rules of board.yml (GitHub board) on another board:
    opened / reopened → review (drops coding + grilling claims) · edited → review when the card still sits in
    todo / grilled (link found late) · ready_for_review → ✅ comment, converted_to_draft → nothing (already review) ·
    synchronize with a coding claim → review (end of an agent round, new `## Feedback` rounds linked), without one →
    reported on the PR · merged → done, run report posted, sprint root closed when the sprint has no branch and its
    last ticket landed · sprint branch merged → sprint root closed · closed unmerged → grilled, unless a coding claim
    or another open PR keeps the ticket going. Every event adds the PR as a link on the card. A column outside the
    six states is a human's: untouched, unless a coding claim proves a round is running. A replay moves nothing
    twice. No hold against a built-in tool workflow: Plane CE has no GitHub integration (single writer)."""
    config = board.config
    pr = payload["pull_request"]
    action = payload.get("action")
    if (pr["head"].get("repo") or {}).get("full_name") != pr["base"]["repo"]["full_name"]:
        return {"action": "none", "reason": "pull request from a fork"}
    number, why = pr_ticket(board, pr)
    link = f"[#{pr['number']}]({pr['html_url']})"
    if number is None:
        prefix, head = config["sprint_prefix"], pr["head"]["ref"]
        if not (prefix and head.startswith(prefix) and action == "closed" and pr.get("merged")):
            return {"action": "none", "reason": why}
        name = head[len(prefix):]
        root = board.open_sprint(name)
        if not root:
            return {"action": "none", "reason": f"sprint branch {head} merged, no open sprint {name!r}"}
        board.close_sprint(root, f"{link} merged `{head}` into `{pr['base']['ref']}`")
        return {"ticket": root, "action": "sprint landed", "reason": f"#{pr['number']} merged {head}"}
    try:
        ticket = board.get(number)
    except Failure as failure:  # sprint root, wa-ignore, unknown card: nothing to move
        return {"ticket": number, "action": "none", "reason": str(failure)}
    linked = board.link_pr(number, pr["number"], pr["title"], pr["html_url"])
    found = f"#{pr['number']} → {number} by {why}" + (", PR linked on the card" if linked else "")
    none = lambda reason: {"ticket": number, "action": "none", "reason": f"{reason} ({found})"}
    state = ticket["state"]
    reclaimed = False
    if ticket["column"] and not state:
        reclaimed = action in ("opened", "reopened", "edited", "synchronize") and claim_held(config, number, "coding")
        if not reclaimed:
            return none(f"card in column {ticket['column']!r}, not a whackagent state: untouched")
        state = "coding"
    draft = "draft " if pr.get("draft") else ""
    moved = lambda to: {"ticket": number, "action": f"{state} → {to}", "reason": f"{action} ({found})"}

    if action in ("opened", "reopened"):
        if state == "done":
            return none("card in done")
        drop_claim(config, number, "coding")
        drop_claim(config, number, "grilling")
        if state == "review":  # replay, or a second PR: the card already says it
            return none("card already in review, claims dropped")
        board.set_state(ticket, "review")
        board.comment(number, f"🔀 **review** — {draft}{link} → `{pr['base']['ref']}`")
        return moved("review")

    if action == "edited":
        # link added after `opened` (body refreshed with the card link): the board learns of the PR late.
        # Never from `coding`: an agent may be mid-round on a PR already known.
        if pr["state"] != "open" or not (reclaimed or state in ("todo", "grilled")):
            return none(f"edited, card in {state}")
        board.set_state(ticket, "review")
        drop_claim(config, number, "coding")
        board.comment(number, f"🔀 **review** — {draft}{link} → `{pr['base']['ref']}`")
        return moved("review")

    if action in ("ready_for_review", "converted_to_draft"):
        # draft ↔ ready changes who looks next (tester or merger), not the state. Never touches the claim: an
        # agent mid-round may flip it (`gh pr ready --undo` before a fix), its push ends the round.
        if action == "ready_for_review" and state != "done":
            board.comment(number, f"✅ **ready** — {link} ready to merge")
            return {"ticket": number, "action": "commented ready", "reason": found}
        return none(action)

    if action == "synchronize":
        after = payload["after"]
        mark = f"round {after[:7]} pushed"
        if not claim_held(config, number, "coding"):
            # no round open: a push nobody claimed. GitHub's own merges (Update branch button) are fine.
            if state == "done":
                return none("push to a landed ticket")
            head = rest("GET", f"repos/{config['repo']}/commits/{after}")
            if (head.get("committer") or {}).get("login") == "web-flow":
                return none("GitHub merge commit (Update branch)")
            comments = plane_all(config["plane_url"], f"{board.base()}/work-items/{ticket['item_id']}/comments/")
            if any(mark in text_of(c.get("comment_html")) for c in comments):
                return none(f"{mark}: already handled")  # replay of a round this hook ended
            report_on_pr(config, pr["number"], f"push-no-claim-{after[:7]}",
                         f"push {after[:7]} to #{pr['number']} while {shown(number)} holds no coding claim: claim before changing a ticket's code, every round")
            return none(f"push {after[:7]} without a coding claim: reported on the PR")
        board.set_state(ticket, "review")
        drop_claim(config, number, "coding")
        rounds = new_feedback(config, number, payload["before"], after)
        notes = "".join(f"\n\n[{p.rsplit('/', 1)[-1]} lines {a}–{b}]({url})" for p, a, b, url in rounds)
        board.comment(number, f"🔀 **review** — {mark} to {link}{notes}")
        if rounds:
            permalinks = "".join(f"\n\n{url}" for *_, url in rounds)  # bare line permalink: GitHub embeds the snippet
            body = f"📝 **feedback** — round pushed for [{number}]({board.ticket_url(number)}){permalinks}"
            rest("POST", f"repos/{config['repo']}/issues/{pr['number']}/comments", {"body": body})
        return moved("review")

    if action == "closed" and pr.get("merged"):
        # mid-stack PR keeps its parent branch as base; a stack merge lands it on the stack base
        landed = ((pr.get("stack") or {}).get("base") or {}).get("ref") or pr["base"]["ref"]
        drop_claim(config, number, "grilling")
        drop_claim(config, number, "coding")
        result = none("card already in done")  # replay: the sprint check below still runs
        if state != "done":
            board.set_state(ticket, "done")
            report = run_report(pr.get("body"))
            board.comment(number, f"🎉 **done** — {link} merged into `{landed}`" + (f"\n\n{report}" if report else ""))
            result = moved("done")
        # Sprint without branch: tickets land straight on the target, so the last one lands the sprint.
        # With a branch, they land in it and the sprint lands with the sprint branch PR (above).
        parent = board.sprint_parent(number)
        if parent and landed != config["sprint_prefix"] + parent[1] and board.sprint_complete(parent[0]):
            board.close_sprint(parent[0], f"last ticket {number} landed")
            result["reason"] += f"; sprint {parent[1]} landed ({parent[0]} → done)"
        return result

    if action == "closed":
        if state in ("done", "grilled"):
            return none(f"closed unmerged, card in {state}")
        # another round is live (a coding claim, or another open PR for the ticket): this PR was superseded
        if claim_held(config, number, "coding"):
            return none("closed unmerged while a coding claim is held")
        for other in board.linked_prs(number):
            if other != pr["number"] and rest("GET", f"repos/{config['repo']}/pulls/{other}")["state"] == "open":
                return none(f"closed unmerged, #{other} still open for the ticket")
        board.set_state(ticket, "grilled")
        drop_claim(config, number, "coding")
        board.comment(number, f"↩️ **grilled** — {link} closed unmerged, spec kept")
        return moved("grilled")

    return none(f"no rule for {action}")


# Board check comments on a Plane card carry external_source + external_id = board-check:<key>:<kind>: Plane refuses
# a second comment with the same pair (HTTP 409), so a problem is reported once even when a human edits the comment
# in the UI (the editor rewrites comment_html and would drop the hidden marker board.yml keys on).
CHECK_SOURCE = "whackagent"
CHECK_RECENT_DAYS = 7  # closed cards changed this recently still get their check comments resolved


def description_spec(markup):
    """Non-empty `## Acceptance criteria` of a Plane card description (HTML headings read as `## ` lines)."""
    return spec_section(text_of(re.sub(r"<h[1-6][^>]*>", "\n## ", markup or "", flags=re.I)), "Acceptance criteria")


def open_ticket_prs(board):
    """Tickets with an open PR, each PR mapped like pr_ticket (branch naming a card of the board, else the one card
    link in its body; sprint PRs left out), read from the open PR list: no comment, no Plane call. Also returns the
    open PR numbers, so a card link to one of them needs no call."""
    config = board.config
    keys = {board.key(i) for i in board.by_id.values()}
    tickets, numbers = set(), set()
    for page in itertools.count(1):
        prs = rest("GET", f"repos/{config['repo']}/pulls?state=open&per_page=100&page={page}") or []
        for pr in prs:
            numbers.add(pr["number"])
            head = pr["head"]["ref"]
            if config["sprint_prefix"] and head.startswith(config["sprint_prefix"]):
                continue
            number = branch_ticket(board, head)
            found = [number] if number in keys else board.linked_tickets(visible_text(pr.get("body")))
            if len(found) == 1:
                tickets.add(found[0])
        if len(prs) < 100:
            return tickets, numbers


def hook_check(board, payload):
    """Scheduled / manual run → report-only board check, the rules of check() in board.yml on a Plane board. Never
    writes a state. Each ticket card in a contract state but done: `grilling` / `coding` with no claim of that phase,
    a claim with nothing new for WA_STALE_AFTER_HOURS, a linked PR merged while none is open and the card is not
    done, `review` with no open PR, an open PR while the card sits in `todo` / `grilled`, `grilled` with no ticket
    branch, acceptance criteria in the description while in `todo`. One card comment per problem (once: external id,
    Plane refuses a duplicate), flipped to resolved in place once the problem clears (cards that closed in the last
    CHECK_RECENT_DAYS days included). An issue's open/closed vs its column (board.yml closed-locked, closed-not-done,
    done-open) has no Plane twin: the column is the card's status. Sprint roots, wa-ignore cards, Canceled and
    columns outside the six states are skipped."""
    config = board.config
    states = {i: s for s, i in config["state_ids"].items() if s in STATES}
    closed = {i for i, group in config["state_groups"].items() if group in PLANE_CLOSED_GROUPS}
    ignore = config["label_ids"].get(IGNORE_LABEL)
    since = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=CHECK_RECENT_DAYS)
    changed = lambda item: dt.datetime.fromisoformat(item["updated_at"].replace("Z", "+00:00")) >= since
    active, recent = [], []
    for item in board.board_items():
        if board.is_root(item) or ignore in (item.get("labels") or []):
            continue
        state = states.get(item["state"])
        if state and state != "done":
            active.append((board.key(item), item, state))
        elif item["state"] in closed and changed(item):
            recent.append((board.key(item), item, None))
    held = claims(config)
    code, refs = rest("GET", f"repos/{config['repo']}/git/matching-refs/heads/{config['branch_prefix']}", check=False)
    branches = {}
    for ref in refs if code == 0 and isinstance(refs, list) else []:
        number = branch_ticket(board, ref["ref"].removeprefix("refs/heads/"))
        if number is not None:
            branches[number] = ref["object"]["sha"]
    open_tickets, open_numbers = open_ticket_prs(board)

    base = board.base()
    comments_of = lambda item: plane_all(config["plane_url"], f"{base}/work-items/{item['id']}/comments/")
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        comments = dict(zip([key for key, *_ in active + recent], pool.map(lambda row: comments_of(row[1]), active + recent)))
        links = dict(zip([key for key, *_ in active], pool.map(lambda row: board.links(row[0]), active)))

    pulls = {}
    def merged(pr):
        if pr not in pulls:
            pulls[pr] = rest("GET", f"repos/{config['repo']}/pulls/{pr}")
        return bool(pulls[pr].get("merged_at"))

    hours = config["stale_after_hours"]
    now = dt.datetime.now(dt.timezone.utc)
    def stale(number, claim):
        """(agent, hours) of a claim with nothing new for `hours`: age = newest of claim and branch head commit."""
        fields = claim_fields(config, claim["sha"])
        latest = fields["date"]
        if number in branches:
            latest = max(latest, rest("GET", f"repos/{config['repo']}/git/commits/{branches[number]}")["committer"]["date"])
        age = int((now - dt.datetime.fromisoformat(latest.replace("Z", "+00:00"))).total_seconds() // 3600)
        return (fields.get("agent", "?"), age) if age >= hours else None

    contract = f"{server_url()}/{config['repo']}/blob/HEAD/BOARD.md"
    found, resolved = [], []
    for key, item, state in active + recent:
        problems = {}
        if state:
            phases = [c["phase"] for c in held.get(key, [])]
            if state in ("grilling", "coding") and state not in phases:
                problems["lock-no-claim"] = f"card in `{state}` but nobody holds a {state} claim: claim it before working, or a human runs `release {key} {state} --reset-to <state>`"
            for claim in held.get(key, []):
                old = stale(key, claim)
                phase = claim["phase"]
                ends = "writes the spec or releases" if phase == "grilling" else "opens the PR or releases"
                if old:
                    problems[f"stale-{phase}"] = f"{phase} claim held by {old[0]}, nothing new for {old[1]} h: its holder {ends}; only a human clears it for them (`release {key} {phase} --reset-to <state> --reason \"stale: …\"`)"
            prs = board.linked_prs(key, links[key])
            is_open = key in open_tickets or any(pr in open_numbers for pr in prs)
            if not is_open and any(merged(pr) for pr in prs):
                problems["merged-not-done"] = f"a linked PR is merged but the card sits in `{state}`"
            if state == "review" and not is_open:
                problems["review-no-pr"] = "card in `review` but no open PR links this ticket"
            if state in ("todo", "grilled") and is_open:
                problems["pr-not-review"] = f"a linked PR is open but the card sits in `{state}`"
            if state == "grilled" and key not in branches:
                problems["grilled-no-spec"] = f"card in `grilled` but no spec: no ticket branch `{config['branch_prefix']}{key}-…` holding its task file"
            if state == "todo" and description_spec(item.get("description_html")):
                problems["spec-todo"] = "the card description holds acceptance criteria but the card sits in `todo`: on a Plane board only a task file pushed on the ticket branch moves it to `grilled`"
        mine = {}
        for c in comments[key]:
            match = re.fullmatch(rf"board-check:{re.escape(key)}:([a-z-]+)", c.get("external_id") or "")
            if c.get("external_source") == CHECK_SOURCE and match:
                mine[match.group(1)] = c
        path = f"{base}/work-items/{item['id']}/comments/"
        for kind, text in problems.items():
            posted = None
            if kind not in mine:
                marker = f"<!-- board-check:{kind} -->"
                body = marker + comment_html(f"⚠️ **board check** — {text}. See [BOARD.md]({contract}); this check only reports, it never moves cards.")
                # 409 = a comment with this external id already exists (posted by a run racing this one)
                posted = board.api("POST", path, {"comment_html": body, "external_source": CHECK_SOURCE,
                                                  "external_id": f"board-check:{key}:{kind}"}, missing=(409,))
            found.append({"ticket": key, "kind": kind, "problem": text, "comment": "posted" if posted else "already posted"})
        for kind, c in mine.items():
            if kind in problems:
                continue
            body = (c.get("comment_html") or "").replace(f"<!-- board-check:{kind} -->", f"<!-- board-check:{kind}:resolved -->")
            body = body.replace("⚠️ <strong>board check</strong>", "✅ <strong>board check — resolved</strong>")
            # a new external id frees the pair, so the problem is reported again if it comes back
            board.api("PATCH", f"{path}{c['id']}/", {"comment_html": body, "external_id": f"board-check:{key}:{kind}:resolved:{c['id']}"})
            resolved.append({"ticket": key, "kind": kind})
    posted = sum(1 for f in found if f["comment"] == "posted")
    reason = f"{len(active)} cards checked, {posted} new comments, {len(resolved)} resolved; never moves cards"
    action = f"{len(found)} problems reported" if found else "none"
    return {"action": action, "reason": reason if found else f"board matches the repository ({reason})",
            "violations": found, "resolved": resolved}


HOOKS = {"push": hook_push, "pull_request": hook_pull_request, "schedule": hook_check, "workflow_dispatch": hook_check}


def op_hook(args):
    event = args.event or os.environ.get("GITHUB_EVENT_NAME")
    source = args.payload or os.environ.get("GITHUB_EVENT_PATH")
    if not event or not source:
        raise Failure("no event: run inside GitHub Actions, or pass --event NAME --payload FILE", EXIT_USAGE)
    payload = json.loads(Path(source).read_text())
    if board_class() is GitHubBoard:
        raise Failure("GitHub board hooks run in board.yml (whackagent-board.yml caller), not here", EXIT_USAGE)
    handler = HOOKS.get(event)
    if handler:
        board = open_board()
        sent_for = (payload.get("repository") or {}).get("full_name")
        if sent_for and sent_for != board.config["repo"]:
            raise Failure(f"event is for {sent_for}, this board's repository is {board.config['repo']}", EXIT_USAGE)
        result = handler(board, payload)
    else:
        result = {"action": "none", "reason": f"no hook for {event}"}
    result = {"event": event, **result}
    note(f"hook {event}: {shown(result['ticket']) + ' ' if 'ticket' in result else ''}{result['action']} — {result['reason']}")
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as out:
            ticket = f" `{shown(result['ticket'])}`" if "ticket" in result else ""
            out.write(f"**whackagent board** · `{event}`{ticket}: {result['action']} — {result['reason']}\n")
            if "violations" in result:  # board check: every problem found, as board.yml's job summary
                out.write("\n### Board check\n\n")
                cell = lambda text: text.replace("|", r"\|")
                rows = [f"| {v['ticket']} | {cell(v['problem'])} | {v['comment']} |\n" for v in result["violations"]]
                out.write("| Ticket | Problem | Comment |\n|---|---|---|\n" + "".join(rows) if rows else "Board matches the repository.\n")
                out.write("".join(f"\n✅ {r['ticket']} `{r['kind']}` resolved\n" for r in result["resolved"]))
    emit(result)


# ---------------------------------------------------------------- cli


def parser():
    p = argparse.ArgumentParser(prog="wa-backlog", description="whackagent backlog provider (GitHub code host, board per backlog.provider: github, plane)")
    sub = p.add_subparsers(dest="op", required=True)

    s = sub.add_parser("config", help="print resolved settings")
    s.add_argument("--refresh", action="store_true", help="re-read repo variables and project ids")
    s.set_defaults(func=op_config)

    s = sub.add_parser("list", help="board rows in priority order")
    s.add_argument("--state", help="comma-separated states")
    s.add_argument("--sprint")
    s.add_argument("--milestone")
    s.add_argument("--all", action="store_true", help="include done")
    s.add_argument("--owners", action="store_true", help="resolve claim owners (one call per claim)")
    s.set_defaults(func=op_list)

    s = sub.add_parser("get")
    s.add_argument("number", type=ticket_id)
    s.set_defaults(func=op_get)

    s = sub.add_parser("create")
    s.add_argument("--title", required=True)
    s.add_argument("--summary", required=True)
    s.add_argument("--size", choices=SIZES)
    s.add_argument("--sprint")
    s.add_argument("--milestone", help='milestone title (default: highest open one, "" = none)')
    s.add_argument("--note")
    s.set_defaults(func=op_create)

    s = sub.add_parser("claim", help="atomic lock; exit 3 when taken")
    s.add_argument("number", type=ticket_id)
    s.add_argument("phase", choices=sorted(CLAIM_FROM))
    s.add_argument("--agent")
    s.add_argument("--blocked-ok", action="store_true", help="coding despite an open blocker (stacked on it, or approved)")
    s.set_defaults(func=op_claim)

    s = sub.add_parser("release")
    s.add_argument("number", type=ticket_id)
    s.add_argument("phase", choices=sorted(CLAIM_FROM))
    s.add_argument("--reset-to", choices=STATES)
    s.add_argument("--reason")
    s.set_defaults(func=op_release)

