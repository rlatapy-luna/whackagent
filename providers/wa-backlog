def op_set_field(args):
    board = open_board()
    if args.field == "size":
        if args.value not in SIZES:
            raise Failure(f"size must be one of {SIZES}", EXIT_USAGE)
        board.set_size(find(board, args.number, with_owners=False), args.value)
    elif args.field == "sprint":
        board.set_sprint(args.number, args.value)
    else:
        board.set_milestone(args.number, args.value)
    emit({"number": args.number, args.field: args.value or None})


def op_split(args):
    """The ticket becomes the root of its split: sprint named after its title, off the board, children
    join it (create --sprint <name>). Number, history and milestone stay."""
    board = open_board()
    number = args.number
    ticket = find(board, number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"{shown(number)} is closed", EXIT_WRONG_STATE)
    if ticket["sprint"]:  # sprints don't nest: the children join this one instead
        raise Failure(f"{shown(number)} is already in sprint {ticket['sprint']!r}", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"{shown(number)} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    name = sprint_name(ticket["title"])
    if not name:
        raise Failure(f"{shown(number)} title has no letter or digit to name a sprint", EXIT_USAGE)
    board.split(ticket, name)
    emit({"number": number, "sprint": name})


def op_comment(args):
    board = open_board()
