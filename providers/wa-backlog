def op_link_pr(args):
    """Manual link from PR <pr> to ticket <n>. Idempotent. Repair only: the hooks link every PR whose ticket
    they find. GitHub board: closing link (Development), from `Closes #n` in the body or a wa/<n>-… branch.
    Plane board: work-item link on the card, from a wa/<id>-… branch or the card link in the body."""
    open_board().link_pr(args.number, args.pr)
    emit({"number": args.number, "pr": args.pr, "linked": True})


def op_claims(args):
    config = load()
    now = dt.datetime.now(dt.timezone.utc)

    def row(number, claim):
        branch = remote_branch(config, number)
        last_push = None
        if branch:
            head = rest("GET", f"repos/{config['repo']}/commits/{branch}")
            last_push = head["commit"]["committer"]["date"]
        owner = claim_owner(config, claim["sha"])
        latest = max(filter(None, [owner["since"], last_push]))
        age = now - dt.datetime.fromisoformat(latest.replace("Z", "+00:00"))
        return {
            "number": number,
            "phase": claim["phase"],
            **owner,
            "branch": branch,
            "last_activity": latest,
            "stale": age.total_seconds() > config["stale_after_hours"] * 3600,
        }

    work = [(number, claim) for number, held in sorted(claims(config).items()) for claim in held]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        emit(list(pool.map(lambda job: row(*job), work)))


def op_whoami(args):
    """`login` = board account (claims assign it, `reserved` compares it). A board whose accounts aren't GitHub's
    adds `vcs_login`: the GitHub account writing claim refs, branches and PRs."""
