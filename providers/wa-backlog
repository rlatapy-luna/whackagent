def op_cancel(args):
    """Ticket closed as not planned: off the board, never claimable, never counted done. Humans decide it:
    skills run it on the user's yes. A claimed ticket is released first; a landed one stays done."""
    board = open_board()
    number = args.number
    ticket = find(board, number, with_owners=False)
    if ticket["not_planned"]:
        emit({"number": number, "canceled": True, "already": True})
        return
    if ticket["closed"]:
        raise Failure(f"{shown(number)} is closed (landed), not canceled", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"{shown(number)} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    board.cancel(ticket)
    board.comment(number, "🚫 **canceled**" + (f" — {args.reason}" if args.reason else ""))
    emit({"number": number, "canceled": True})


def op_milestones(args):
