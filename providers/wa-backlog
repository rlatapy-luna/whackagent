# ---------------------------------------------------------------- GitHub board (Projects v2)

DEFAULT_STATE_NAMES = {
    "todo": "Todo",
    "grilling": "Grilling",
    "grilled": "Grilled",
    "coding": "Coding",
    "review": "Review",
    "done": "Done",
}
STATE_COLORS = {
    "todo": "GRAY",
    "grilling": "ORANGE",
    "grilled": "BLUE",
    "coding": "PURPLE",
    "review": "YELLOW",
    "done": "GREEN",
}
STATE_DESCRIPTIONS = {
    "todo": "Not grilled yet",
    "grilling": "Locked: an agent is grilling it",
    "grilled": "Spec written (issue body or its branch), ready to code",
    "coding": "Locked: an agent is coding it",
    "review": "PR open",
    "done": "PR merged",
}
SIZE_COLORS = {"quickwin": "GREEN", "medium": "YELLOW", "large": "RED"}
IGNORE_LABEL = "wa-ignore"
# Sprint = parent issue labeled wa-sprint, sprint name = its title in kebab-case; its tickets are its
# sub-issues. Not a ticket itself: kept off the board, never claimed. The milestone is the release scope.
SPRINT_LABEL = "wa-sprint"
# Built-in Project workflows that set Status on their own, against the board contract.
CONFLICTING_WORKFLOWS = {"Pull request linked to issue"}

ITEM_FIELDS = """
  id
  content { __typename
    ... on Issue { number title body url state stateReason
      milestone { title } labels(first:20) { nodes { name } } assignees(first:10) { nodes { login } }
      parent { number title labels(first:20) { nodes { name } } } }
    ... on DraftIssue { title } }
  fieldValues(first:50) { nodes {
    ... on ProjectV2ItemFieldSingleSelectValue { optionId field { ... on ProjectV2SingleSelectField { id } } } } }
"""


def owner_node(owner):
    """Projects hang off a user or an organization; the GraphQL root differs."""
    data = graphql(
        "query($l:String!){repositoryOwner(login:$l){__typename id}}", l=owner
    )["repositoryOwner"]
    if not data:
        raise Failure(f"unknown owner {owner}")
    return data["__typename"].lower(), data["id"]


def project_fields(owner_kind, owner, number):
    data = graphql(
        f"""query($l:String!,$n:Int!){{{owner_kind}(login:$l){{projectV2(number:$n){{id url
            fields(first:50){{nodes{{... on ProjectV2SingleSelectField{{id name options{{id name color description}}}}}}}}}}}}}}""",
        l=owner,
        n=number,
    )[owner_kind]["projectV2"]
    if not data:
        raise Failure(f"project {owner}/{number} not found")
    fields = {f["name"]: f for f in data["fields"]["nodes"] if f}
    return data["id"], data["url"], fields


def project_items(project_id):
    query = f"""query($p:ID!,$after:String){{node(id:$p){{... on ProjectV2{{
        items(first:100, after:$after){{pageInfo{{hasNextPage endCursor}} nodes{{{ITEM_FIELDS}}}}}}}}}}}"""
    after, nodes = None, []
    while True:
        page = graphql(query, p=project_id, after=after)["node"]["items"]
        nodes += page["nodes"]
        if not page["pageInfo"]["hasNextPage"]:
            return nodes
        after = page["pageInfo"]["endCursor"]


def is_sprint(issue):
    return SPRINT_LABEL in [l["name"] for l in issue["labels"]["nodes"]]


def sprint_of(parent):
    return sprint_name(parent["title"]) if parent and is_sprint(parent) else None


def milestone_rank(milestone):
    """Version order of the title (digit runs compared as numbers: 0.10.0 > 0.9.0 > 0.3.0 > 0.2.1), then creation order."""
    parts = re.findall(r"\d+|\D+", milestone["title"].casefold())
    return [(1, int(part), "") if part.isdigit() else (0, 0, part) for part in parts], milestone["number"]


def cards_on_options(project_id, field_id):
    """Cards sitting on each Status option id: an option holding a card is never dropped."""
    held = {}
    for node in project_items(project_id):
        for value in node["fieldValues"]["nodes"]:
            if value and (value.get("field") or {}).get("id") == field_id:
                content = node["content"] or {}
                card = f"#{content['number']}" if "number" in content else content.get("title") or node["id"]
                held.setdefault(value["optionId"], []).append(card)
    return held


def ensure_status_options(field, state_names, project_id, prune):
    """Make the Status field carry every state. Existing options keep their ids, so no card loses its Status.

    `prune` also drops options no state maps to: True = every one (GitHub's default "In Progress"), else only
    the names it lists. Pruning puts the states in lifecycle order, extra options after them; an option to
    drop that still holds a card stays. Returns (changed, removed names, extra names left, {held name: cards}).
    """
    existing = {o["name"]: o for o in field["options"]}
    wanted = [state_names[s] for s in STATES]
    extra = [o for o in field["options"] if o["name"] not in wanted]
    missing = [s for s in STATES if state_names[s] not in existing]

    def keep(option):
        return {
            "id": option["id"],
            "name": option["name"],
            "color": option["color"],
            "description": option["description"] or "",
        }

    def fresh(state):
        return {"name": state_names[state], "color": STATE_COLORS[state], "description": STATE_DESCRIPTIONS[state]}

    held = {}
    if prune:
        targets = [o for o in extra if prune is True or o["name"] in prune]
        cards = cards_on_options(project_id, field["id"]) if targets else {}
        held = {o["name"]: cards[o["id"]] for o in targets if o["id"] in cards}
        removed = [o["name"] for o in targets if o["name"] not in held]
        left = [o for o in extra if o["name"] not in removed]
        options = [keep(existing[n]) if n in existing else fresh(s) for s, n in zip(STATES, wanted)]
        options += [keep(o) for o in left]
        if [o["name"] for o in options] == [o["name"] for o in field["options"]]:
            return False, [], [o["name"] for o in left], held
    else:
        left, removed = extra, []
        if not missing:
            return False, [], [o["name"] for o in extra], held
        # The mutation replaces the whole option list: resend every existing option exactly as it is
        # (id, color, description) and append only the missing states.
        options = [keep(o) for o in field["options"]] + [fresh(s) for s in missing]
    graphql(
        """mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]){updateProjectV2Field(input:{
            fieldId:$f,singleSelectOptions:$o}){projectV2Field{... on ProjectV2SingleSelectField{id}}}}""",
        f=field["id"],
        o=options,
    )
    return True, removed, [o["name"] for o in left], held


class GitHubBoard(Board):
    """GitHub Projects v2: ticket = issue on the Project, state = Status option, priority = item order,
    size = Size option, sprint = wa-sprint parent issue, milestone = repo milestone."""

    name = "a GitHub"

    @classmethod
    def check_id(cls, number):
        if not isinstance(number, int):
            raise Failure(f"tickets on a GitHub board are issue numbers (12), not {number}", EXIT_USAGE)

    @classmethod
    def settings(cls, repo, variables):
        if "WA_PROJECT_NUMBER" not in variables:
            raise Failure(f"{repo} has no WA_PROJECT_NUMBER variable — run /wa-setup backlog (provision)")
        owner = variables.get("WA_PROJECT_OWNER", repo.split("/")[0])
        number = int(variables["WA_PROJECT_NUMBER"])
        owner_kind, _ = owner_node(owner)
        project_id, url, fields = project_fields(owner_kind, owner, number)
        status_name = variables.get("WA_STATUS_FIELD", "Status")
        size_name = variables.get("WA_SIZE_FIELD", "Size")
        custom = json.loads(variables.get("WA_STATES", "{}"))
        # Unknown keys ignored: a transitional WA_STATES may still carry an old state id for older hooks.
        state_names = {s: custom.get(s, DEFAULT_STATE_NAMES[s]) for s in STATES}
        status = fields.get(status_name)
        if not status:
            raise Failure(f"project has no single-select field {status_name!r}")
        options = {o["name"]: o["id"] for o in status["options"]}
        missing = [s for s, n in state_names.items() if n not in options]
        if missing:
            raise Failure(f"Status options missing for {missing} — run provision again")
        size = fields.get(size_name)
        return {
            "owner": owner,
            "owner_kind": owner_kind,
            "project_number": number,
            "project_id": project_id,
            "project_url": url,
            "status_field": status["id"],
            "status_option_names": {o["id"]: o["name"] for o in status["options"]},
            "state_options": {s: options[n] for s, n in state_names.items()},
            "state_names": state_names,
            "size_field": size["id"] if size else None,
            "size_options": {o["name"]: o["id"] for o in size["options"]} if size else {},
        }

    # ------------------------------------------------ reading

    def to_ticket(self, node):
        config = self.config
        content = node["content"] or {}
        if content.get("__typename") != "Issue":
            return {"draft": True, "title": content.get("title", ""), "item_id": node["id"]}
        values = {
            v["field"]["id"]: v["optionId"]
            for v in node["fieldValues"]["nodes"]
            if v and v.get("field")
        }
        by_option = {o: s for s, o in config["state_options"].items()}
        by_size = {o: s for s, o in config["size_options"].items()}
        status_option = values.get(config["status_field"])
        if status_option and status_option not in config["status_option_names"]:
            raise StaleCache(f"unknown Status option {status_option}")
        assignees = [a["login"] for a in content["assignees"]["nodes"]]
        return {
            "number": content["number"],
            "title": content["title"],
            "summary": summary_of(content["body"]),
            "state": by_option.get(status_option),
            "column": config["status_option_names"].get(status_option),
            "size": by_size.get(values.get(config["size_field"])),
            "sprint": sprint_of(content["parent"]),
            "milestone": (content["milestone"] or {}).get("title"),
            "closed": content["state"] == "CLOSED",
            "not_planned": content.get("stateReason") == "NOT_PLANNED",
            "ignored": bool({IGNORE_LABEL, SPRINT_LABEL} & {l["name"] for l in content["labels"]["nodes"]}),
            "assignees": assignees,
            # Assigned to someone else: a human reserved it, no agent of another account may claim it.
            "reserved": bool(assignees) and self.me() not in assignees,
            "claims": [],  # the core fills it in, here so the key keeps its place in the output
            "url": content["url"],
            "item_id": node["id"],
        }

    def tickets(self):
        return [self.to_ticket(node) for node in project_items(self.config["project_id"])]

    def get(self, number):
        """Read one ticket through the issue, not the project item list: that list lags behind
        writes by minutes, the issue's own projectItems don't."""
        config = self.config
        owner, name = config["repo"].split("/")
        query = f"""query($o:String!,$r:String!,$n:Int!){{repository(owner:$o,name:$r){{issue(number:$n){{
            title labels(first:20){{nodes{{name}}}} projectItems(first:20){{nodes{{project{{id}} {ITEM_FIELDS}}}}}}}}}}}"""
        for attempt in range(2):
            issue = graphql(query, o=owner, r=name, n=number)["repository"]["issue"]
            if not issue:
                raise Failure(f"#{number} does not exist")
            if is_sprint(issue):
                raise Failure(f"#{number} is sprint {issue['title']!r}, not a ticket", EXIT_WRONG_STATE)
            if IGNORE_LABEL in [l["name"] for l in issue["labels"]["nodes"]]:
                raise Failure(f"#{number} is labeled {IGNORE_LABEL}, not a ticket", EXIT_WRONG_STATE)
            for node in issue["projectItems"]["nodes"]:
                if node["project"]["id"] == config["project_id"]:
                    ticket = self.to_ticket(node)
                    if ticket["column"] is None:  # no Status at all: fresh card, not a column we don't know
                        self.set_state(ticket, "todo")
                        ticket["state"] = ticket["column"] = "todo"
                    return ticket
            if attempt == 0:
                self.add_to_board(number)  # every issue is a ticket; the opened hook may have missed it
        raise Failure(f"#{number} could not be added to the board")

    def blocked_by(self, number):
        rows = rest("GET", f"repos/{self.config['repo']}/issues/{number}/dependencies/blocked_by")
        return [{"number": r["number"], "state": r["state"]} for r in rows]

    def me(self):
        return viewer_login()

    def ticket_url(self, number):
        return rest("GET", f"repos/{self.config['repo']}/issues/{number}")["html_url"]

    # ------------------------------------------------ writing

    def issue_node_id(self, number):
        return rest("GET", f"repos/{self.config['repo']}/issues/{number}")["node_id"]

    def add_to_board(self, number):
        return graphql(
            "mutation($p:ID!,$c:ID!){addProjectV2ItemById(input:{projectId:$p,contentId:$c}){item{id}}}",
            p=self.config["project_id"],
            c=self.issue_node_id(number),
        )["addProjectV2ItemById"]["item"]["id"]

    def set_option(self, item_id, field, option):
        graphql(
            """mutation($p:ID!,$i:ID!,$f:ID!,$o:String!){updateProjectV2ItemFieldValue(input:{
                projectId:$p,itemId:$i,fieldId:$f,value:{singleSelectOptionId:$o}}){projectV2Item{id}}}""",
            p=self.config["project_id"],
            i=item_id,
            f=field,
            o=option,
        )

    def set_state(self, ticket, state):
        self.set_option(ticket["item_id"], self.config["status_field"], self.config["state_options"][state])

    def move(self, number, before=None, after=None, bottom=False):
        config = self.config
        nodes = [n for n in project_items(config["project_id"]) if (n["content"] or {}).get("number") is not None]
        by_number = {n["content"]["number"]: n["id"] for n in nodes}
        order = [n["content"]["number"] for n in nodes]
        for n in filter(lambda n: n is not None, [number, before, after]):
            if n not in by_number:
                raise Failure(f"#{n} is not on the board (or not listed yet — new cards show up after 1–3 min)", EXIT_USAGE)
        anchor = None
        if bottom:
            rest_order = [n for n in order if n != number]
            anchor = by_number[rest_order[-1]] if rest_order else None
        elif after is not None:
            anchor = by_number[after]
        elif before is not None:
            rest_order = [n for n in order if n != number]
            index = rest_order.index(before)
            anchor = by_number[rest_order[index - 1]] if index > 0 else None
        variables = {"p": config["project_id"], "i": by_number[number]}
        if anchor:
            variables["a"] = anchor
        graphql(
            "mutation($p:ID!,$i:ID!,$a:ID){updateProjectV2ItemPosition(input:{projectId:$p,itemId:$i,afterId:$a}){clientMutationId}}",
            **variables,
        )

    def set_size(self, ticket, size):
        if not self.config["size_field"]:
            raise Failure("project has no Size field — run provision again")
        self.set_option(ticket["item_id"], self.config["size_field"], self.config["size_options"][size])

    def assign(self, number, login):
        code, data = rest(
            "POST", f"repos/{self.config['repo']}/issues/{number}/assignees", {"assignees": [login]}, check=False
        )
        return code == 0 and login in [a["login"] for a in (data or {}).get("assignees", [])]

    def unassign(self, number, login):
        rest("DELETE", f"repos/{self.config['repo']}/issues/{number}/assignees", {"assignees": [login]}, check=False)

    def comment(self, number, text):
        rest("POST", f"repos/{self.config['repo']}/issues/{number}/comments", {"body": text})

    def create(self, title, body, milestone=None, size=None, sprint=None):
        # No milestone: the highest open milestone, so new work lands in the scope being planned,
        # never in the current or a past one. "" = none. Resolved first: a bad title creates nothing.
        milestone = self.latest_milestone() if milestone is None else self.milestone_number(milestone)
        issue = rest("POST", f"repos/{self.config['repo']}/issues", {"title": title, "body": body, "milestone": milestone})
        number = issue["number"]
        item_id = self.add_to_board(number)  # idempotent with the issues.opened hook
        ticket = {"number": number, "item_id": item_id}
        self.set_state(ticket, "todo")
        if size:
            self.set_size(ticket, size)
        if sprint:
            self.set_sprint(number, sprint)
        return {"number": number, "url": issue["html_url"], "milestone": (issue["milestone"] or {}).get("title")}

    # ------------------------------------------------ milestones

    def repo_milestones(self, state):
        return rest("GET", f"repos/{self.config['repo']}/milestones?state={state}&per_page=100")

    def latest_milestone(self):
        """Number of the highest open milestone (milestone_rank), or None. Track milestones (branch.tracks)
        never: new work lands on base, joining a track is the user's call."""
        tracks = set(self.config.get("tracks", []))
        opened = [m for m in self.repo_milestones("open") if m["title"] not in tracks]
        return max(opened, key=milestone_rank)["number"] if opened else None

    def milestone_number(self, title):
        """Milestones are made and closed by humans: an unknown title is an error, never created. "" = none."""
        if not title:
            return None
        found = [m for m in self.repo_milestones("all") if m["title"] == title]
        if not found:
            raise Failure(f"no milestone {title!r} — create it on GitHub first", EXIT_USAGE)
        return found[0]["number"]

    def milestones(self):
        highest_first = lambda ms: sorted(ms, key=milestone_rank, reverse=True)
        rows = highest_first(self.repo_milestones("open"))
        rows += [m for m in highest_first(self.repo_milestones("closed")) if m["open_issues"]]
        return [
            {"title": m["title"], "open": m["state"] == "open", "tickets": m["open_issues"] + m["closed_issues"], "done": m["closed_issues"]}
            for m in rows
        ]

    def close_milestone(self, title):
        number = self.milestone_number(title)
        if number is None:
            raise Failure("milestone title required", EXIT_USAGE)
        rest("PATCH", f"repos/{self.config['repo']}/milestones/{number}", {"state": "closed"})

    def set_milestone(self, number, title):
        rest("PATCH", f"repos/{self.config['repo']}/issues/{number}", {"milestone": self.milestone_number(title)})

    # ------------------------------------------------ sprints

    def sprint_issues(self, name):
        return [
            i for i in rest("GET", f"repos/{self.config['repo']}/issues?labels={SPRINT_LABEL}&state=all&per_page=100")
            if sprint_name(i["title"]) == name and "pull_request" not in i
        ]

    def sprint_issue(self, name):
        """Number of sprint <name>'s parent issue, created on first use. A closed one (sprint landed
        before) is reopened: same name, same sprint."""
        repo = self.config["repo"]
        found = self.sprint_issues(name)
        if found:
            if found[0]["state"] == "closed":
                rest("PATCH", f"repos/{repo}/issues/{found[0]['number']}", {"state": "open"})
            return found[0]["number"]
        body = "Sprint: whackagent groups its tickets here as sub-issues. Closed when the sprint lands."
        return rest("POST", f"repos/{repo}/issues", {"title": name, "body": body, "labels": [SPRINT_LABEL]})["number"]

    def set_sprint(self, number, sprint):
        """Make the ticket a sub-issue of sprint <sprint>'s parent issue; "" detaches it."""
        repo = self.config["repo"]
        sprint = sprint_name(sprint)
        owner, name = repo.split("/")
        parent = graphql(
            "query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){issue(number:$n){parent{number title labels(first:20){nodes{name}}}}}}",
            o=owner, r=name, n=number,
        )["repository"]["issue"]["parent"]
        if parent and not is_sprint(parent):  # one parent per issue: never replace a human's own hierarchy
            raise Failure(f"#{number} is already a sub-issue of #{parent['number']} (not a sprint) — detach it first", EXIT_WRONG_STATE)
        if sprint_of(parent) == (sprint or None):
            return
        issue_id = rest("GET", f"repos/{repo}/issues/{number}")["id"]
        if not sprint:
            rest("DELETE", f"repos/{repo}/issues/{parent['number']}/sub_issue", {"sub_issue_id": issue_id})
            return
        target = self.sprint_issue(sprint)
        rest("POST", f"repos/{repo}/issues/{target}/sub_issues", {"sub_issue_id": issue_id, "replace_parent": True})

    def split(self, ticket, name):
        """The issue becomes the sprint's parent: labeled wa-sprint, taken off the board."""
        number = ticket["number"]
        clash = self.sprint_issues(name)
        if clash:
            raise Failure(f"sprint {name!r} already exists (#{clash[0]['number']}) — retitle #{number} first", EXIT_WRONG_STATE)
        rest("POST", f"repos/{self.config['repo']}/issues/{number}/labels", {"labels": [SPRINT_LABEL]})
        graphql(
            "mutation($p:ID!,$i:ID!){deleteProjectV2Item(input:{projectId:$p,itemId:$i}){deletedItemId}}",
            p=self.config["project_id"],
            i=ticket["item_id"],
        )
        self.comment(number, f"🌳 **split** — sprint `{name}`, its tickets are the sub-issues of this issue")

    # ------------------------------------------------ other

    def depend(self, number, blockers):
        """Issue Relationships. Idempotent."""
        blocked = self.issue_node_id(number)
        added, kept = [], []
        for blocker in blockers:
            try:
                graphql(
                    "mutation($i:ID!,$b:ID!){addBlockedBy(input:{issueId:$i,blockingIssueId:$b}){issue{number}}}",
                    i=blocked,
                    b=self.issue_node_id(blocker),
                )
                added.append(blocker)
            except Failure as error:
                if "already" not in str(error).lower():
                    raise
                kept.append(blocker)
        return added, kept

    def link_pr(self, number, pr):
        """PR Development link. Idempotent."""
        repo = self.config["repo"]
        issue = rest("GET", f"repos/{repo}/issues/{number}")
        graphql(
            "mutation($i:ID!,$p:[ID!]!){addCloseIssueReferences(input:{issueId:$i,pullRequestIds:$p}){clientMutationId}}",
            i=issue["node_id"],
            p=[rest("GET", f"repos/{repo}/pulls/{pr}")["node_id"]],
        )

    @classmethod
    def provision(cls, args, repo):
        owner = args.owner or repo.split("/")[0]
        owner_kind, owner_id = owner_node(owner)
        created = False
        if not args.title and not args.project:
            raise Failure("pass --title (new project) or --project <number> (adopt)", EXIT_USAGE)
        if args.project:
            if args.template:
                raise Failure("--template copies into a new project: pass it with --title, not --project", EXIT_USAGE)
            if not str(args.project).isdigit():
                raise Failure(f"--project expects a GitHub project number, got {args.project!r}", EXIT_USAGE)
            number = int(args.project)
        elif args.template:
            source_owner, _, source_number = args.template.rpartition("/")
            source_owner = source_owner or owner
            if not source_number.isdigit():
                raise Failure(f"--template expects [OWNER/]NUMBER, got {args.template!r}", EXIT_USAGE)
            source_id = project_fields(owner_node(source_owner)[0], source_owner, int(source_number))[0]
            project = graphql(
                """mutation($p:ID!,$o:ID!,$t:String!){copyProjectV2(input:{
                    projectId:$p,ownerId:$o,title:$t,includeDraftIssues:false}){projectV2{number}}}""",
                p=source_id,
                o=owner_id,
                t=args.title,
            )["copyProjectV2"]["projectV2"]
            number, created = project["number"], True
        else:
            project = graphql(
                "mutation($o:ID!,$t:String!){createProjectV2(input:{ownerId:$o,title:$t}){projectV2{number}}}",
                o=owner_id,
                t=args.title,
            )["createProjectV2"]["projectV2"]
            number, created = project["number"], True
        project_id, url, fields = project_fields(owner_kind, owner, number)
        repo_id = rest("GET", f"repos/{repo}")["node_id"]
        prepare_repo(repo)
        graphql(
            "mutation($p:ID!,$r:ID!){linkProjectV2ToRepository(input:{projectId:$p,repositoryId:$r}){clientMutationId}}",
            p=project_id,
            r=repo_id,
        )
        state_names = dict(DEFAULT_STATE_NAMES)
        for pair in args.state or []:
            state, _, name = pair.partition("=")
            if state not in STATES:
                raise Failure(f"unknown state {state!r}, expected one of {STATES}", EXIT_USAGE)
            state_names[state] = name
        status = fields.get(args.status_field)
        if not status:
            raise Failure(f"project has no single-select field {args.status_field!r}")
        # A board created here (no template) holds no card and no human column: GitHub's default options go.
        # A template copy or an adopted board keeps its extra columns unless named (--prune-status <name>).
        named = set(args.prune_status or [])
        if named & set(state_names.values()):
            raise Failure(f"--prune-status names a state column: {sorted(named & set(state_names.values()))}", EXIT_USAGE)
        pruned = True if created and not args.template else named
        changed_status, removed, extra, held = ensure_status_options(status, state_names, project_id, pruned)
        size_created = False
        if args.size_field not in fields:
            graphql(
                """mutation($p:ID!,$n:String!,$o:[ProjectV2SingleSelectFieldOptionInput!]){createProjectV2Field(input:{
                    projectId:$p,dataType:SINGLE_SELECT,name:$n,singleSelectOptions:$o}){clientMutationId}}""",
                p=project_id,
                n=args.size_field,
                o=[{"name": s, "color": SIZE_COLORS[s], "description": ""} for s in SIZES],
            )
            size_created = True
        variables = {
            "WA_PROJECT_OWNER": owner,
            "WA_PROJECT_NUMBER": str(number),
            "WA_STATUS_FIELD": args.status_field,
            "WA_SIZE_FIELD": args.size_field,
            "WA_STATES": json.dumps(state_names),
            **code_variables(args),
        }
        set_variables(repo, variables)
        config = load(refresh=True)
        secret = gh(["secret", "list", "--repo", repo, "--json", "name", "--jq", ".[].name"], check=False).stdout.split()
        # GitHub's built-in Project workflows that move cards behind the hooks' back. API can only delete them:
        # setup asks a human to switch them off in the Project settings.
        workflows = graphql(
            f"query($l:String!,$n:Int!){{{owner_kind}(login:$l){{projectV2(number:$n){{workflows(first:20){{nodes{{name enabled}}}}}}}}}}",
            l=owner, n=number,
        )[owner_kind]["projectV2"]["workflows"]["nodes"]
        conflicting = [w["name"] for w in workflows if w["enabled"] and w["name"] in CONFLICTING_WORKFLOWS]
        return {
            "project_url": url,
            "project_number": number,
            "project_created": created,
            "project_template": args.template,
            "status_options_changed": changed_status,
            "status_options_added": changed_status,  # old name, kept for callers that read it
            "status_options_removed": removed,
            "status_options_extra": extra,
            "status_options_held": held,
            "size_field_created": size_created,
            "variables": variables,
            "secret_WA_PROJECT_TOKEN": "WA_PROJECT_TOKEN" in secret,
            "state_options": config["state_options"],
            "conflicting_workflows": conflicting,
        }

    @classmethod
    def templates(cls, owner):
        owner = owner or current_repo().split("/")[0]
        kind = owner_node(owner)[0]
        nodes = graphql(
            f"""query($l:String!){{{kind}(login:$l){{projectsV2(first:100,query:"is:template"){{
                nodes{{number title url template closed}}}}}}}}""",
            l=owner,
        )[kind]["projectsV2"]["nodes"]
        return [{"number": n["number"], "title": n["title"], "url": n["url"]} for n in nodes if n["template"] and not n["closed"]]


# ---------------------------------------------------------------- Plane board (Plane Community Edition)

# Contract states + canceled, board order. State → (name provision gives a state it creates, Plane group, color).
PLANE_STATES = {
    "todo": ("Todo", "unstarted", "#60646C"),
    "grilling": ("Grilling", "started", "#8E4EC6"),
    "grilled": ("Grilled", "started", "#3E63DD"),
    "coding": ("Coding", "started", "#F59E0B"),
    "review": ("Review", "started", "#E5484D"),
    "done": ("Done", "completed", "#46A758"),
    "canceled": ("Canceled", "cancelled", "#9AA4BC"),
}
# Plane's seed name, adopted before a state is created (a new project carries "Cancelled").
PLANE_STATE_ALIASES = {"canceled": ["Cancelled"]}
PLANE_LABELS = {IGNORE_LABEL: "#9AA4BC", SPRINT_LABEL: "#3E63DD"}
PLANE_KEY_ENV = "PLANE_API_KEY"  # agents: environment only; hooks: Actions secret WA_PLANE_API_KEY
PLANE_PAGE = 1000  # per_page ceiling of Plane's paginator
PLANE_TRIES = 5
# Plane's own per-key throttle defaults to 60/minute; the provider requires API_KEY_RATE_LIMIT=1000000/second.
PLANE_LIFTED = 1000  # X-RateLimit-Remaining above this = limit lifted


def plane_call(url, method, path, body=None, missing=()):
    """(data, headers) of one /api/v1 call. HTTP 429 → sleep Retry-After, retry (bounded); `missing` codes → None."""
    key = os.environ.get(PLANE_KEY_ENV)
    if not key:
        raise Failure(f"{PLANE_KEY_ENV} not set — export the Plane API key in this shell (never in the repo or config)")
    request = urllib.request.Request(
        f"{url.rstrip('/')}/api/v1/{path.lstrip('/')}",
        data=json.dumps(body).encode() if body is not None else None,
        method=method,
        headers={"X-API-Key": key, "Content-Type": "application/json", "Accept": "application/json"},
    )
    for attempt in range(PLANE_TRIES):
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                raw = response.read()
                return (json.loads(raw) if raw else None), response.headers
        except urllib.error.HTTPError as error:
            raw = error.read()
            if error.code == 429 and attempt < PLANE_TRIES - 1:
                retry = error.headers.get("Retry-After") or ""
                wait = min(int(retry) if retry.isdigit() else 10, 60)
                note(f"Plane rate limit hit, retry in {wait}s — lift it: API_KEY_RATE_LIMIT=1000000/second on the server")
                time.sleep(wait)
                continue
            if error.code in missing:
                return None, error.headers
            try:
                reason = json.loads(raw)
                reason = reason.get("error") or reason.get("detail") or reason
            except ValueError:
                reason = raw.decode(errors="replace")[:200]
            raise Failure(f"Plane {method} {path}: HTTP {error.code} {reason}")
        except urllib.error.URLError as error:
            raise Failure(f"Plane unreachable at {url}: {error.reason}")
    raise Failure(f"Plane {method} {path}: still rate limited after {PLANE_TRIES} tries")


def plane_api(url, method, path, body=None, missing=()):
    return plane_call(url, method, path, body, missing)[0]


def plane_all(url, path):
    """Every row of a list endpoint: a bare list, or cursor pages of {results} (PLANE_PAGE rows each)."""
    rows, cursor = [], None
    sep = "&" if "?" in path else "?"
    while True:
        page = plane_api(url, "GET", f"{path}{sep}per_page={PLANE_PAGE}" + (f"&cursor={cursor}" if cursor else ""))
        if isinstance(page, list):
            return page
        rows += page.get("results", [])
        if not page.get("next_page_results"):
            return rows
        cursor = page["next_cursor"]


def html_of(markdown):
    """Ticket body → Plane description (stored as HTML): one <p> per paragraph, line breaks kept."""
    paragraphs = [p for p in re.split(r"\n\s*\n", (markdown or "").strip()) if p.strip()]
    return "".join("<p>" + "<br>".join(html.escape(line) for line in p.splitlines()) + "</p>" for p in paragraphs) or "<p></p>"


def text_of(markup):
    """Plane description → plain text, one line per block."""
    text = re.sub(r"<br\s*/?>|</(?:p|div|li|h\d|pre|blockquote)>", "\n", markup or "", flags=re.I)
    return html.unescape(re.sub(r"<[^>]+>", "", text))


def ensure_plane_states(url, base, names, prune):
    """Make the project carry the seven states (six contract states + canceled) in their Plane groups, in board
    order, Todo the default. Adopts a state by name (`names` overrides, else default name, then Plane's seed
    alias), creates the missing ones. Never renames or deletes a state on its own: extra columns stay and
    are reported; `prune` names extras to delete, and one still holding cards stays (Plane refuses).
    Returns ({state: id}, report)."""
    path = f"{base}/states/"
    have = plane_all(url, path)
    by_name = {s["name"]: s for s in have}
    report = {"created": [], "updated": [], "removed": [], "extra": [], "held": {}, "default_changed": False}
    ids = {}
    for index, (state, (default_name, group, color)) in enumerate(PLANE_STATES.items(), 1):
        name = names.get(state, default_name)
        found = by_name.get(name)
        if not found and state not in names:
            found = next((by_name[a] for a in PLANE_STATE_ALIASES.get(state, []) if a in by_name), None)
        want = {"group": group, "sequence": index * 10000}
        if not found:
            # POST ignores `sequence` (appends at the end): the PATCH below puts it in place.
            found = plane_api(url, "POST", path, {"name": name, "color": color, **want})
            report["created"].append(name)
        changes = {k: v for k, v in want.items() if found.get(k) != v}
        if changes:
            found = plane_api(url, "PATCH", f"{path}{found['id']}/", changes)
            if found["name"] not in report["created"]:
                report["updated"].append(found["name"])
        ids[state] = found["id"]
    # A card created in the Plane UI without a state lands in the default one: todo. PATCH default=true does not
    # clear the previous default (Plane 1.4.2 bug), so every other default is cleared by hand.
    current = {s["id"]: s for s in plane_all(url, path)}
    if not current[ids["todo"]].get("default"):
        plane_api(url, "PATCH", f"{path}{ids['todo']}/", {"default": True})
        report["default_changed"] = True
    for state in current.values():
        if state["id"] != ids["todo"] and state.get("default"):
            plane_api(url, "PATCH", f"{path}{state['id']}/", {"default": False})
            report["default_changed"] = True
    extras = [s for s in current.values() if s["id"] not in ids.values()]
    named = set(prune or [])
    ours = {current[i]["name"] for i in ids.values()}
    if named & ours:
        raise Failure(f"--prune-status names a state column: {sorted(named & ours)}", EXIT_USAGE)
    doomed = [s for s in extras if s["name"] in named]
    for state in doomed:
        plane_api(url, "DELETE", f"{path}{state['id']}/", missing=(400,))  # 400: not empty, Plane keeps it
    left = {s["id"] for s in plane_all(url, path)} if doomed else set()
    report["removed"] = [s["name"] for s in doomed if s["id"] not in left]
    held_ids = [s["id"] for s in doomed if s["id"] in left]
    if held_ids:
        project_key = plane_api(url, "GET", f"{base}/")["identifier"]
        for item in plane_all(url, f"{base}/work-items/"):
            if item["state"] in held_ids:
                report["held"].setdefault(current[item["state"]]["name"], []).append(f"{project_key}-{item['sequence_id']}")
    report["extra"] = [s["name"] for s in sorted(extras, key=lambda s: s["sequence"]) if s["name"] not in report["removed"]]
    return ids, report


def ensure_plane_labels(url, base):
    """Labels the board reads: wa-ignore (not a ticket), wa-sprint (sprint root, off the board). Returns created names."""
    have = {l["name"] for l in plane_all(url, f"{base}/labels/")}
    created = []
    for name, color in PLANE_LABELS.items():
        if name not in have:
            plane_api(url, "POST", f"{base}/labels/", {"name": name, "color": color}, missing=(409,))
            created.append(name)
    return created


class PlaneBoard(Board):
    """Plane CE project: ticket = work item, id = its key "WA-42", state = Plane state (ids in WA_PLANE_STATES,
    plus Canceled), priority = sort_order within the state (lower = higher), excluded = label wa-ignore.
    No size (Plane CE estimates are UI-only). Writes beyond create, sprints, milestones: not built yet."""

    name = "a Plane"
    # Contract operations later issues build (claims, fields, sprints, milestones, hooks): "not yet", not "never".
    PENDING = {"set-state", "move", "assignment", "comment", "close-milestone", "milestone", "split", "sprint", "depend", "link-pr"}

    def __init__(self, config):
        super().__init__(config)
        self.items = {}  # key → work item read this run
        self.members = None

    @classmethod
    def unsupported(cls, operation):
        if operation in cls.PENDING:
            return Failure(f"{operation} is not built yet on a Plane board (experimental provider)", EXIT_USAGE)
        return super().unsupported(operation)

    @classmethod
    def check_id(cls, number):
        if not isinstance(number, str):
            raise Failure(f"tickets on a Plane board are keys like WA-42, not {number}", EXIT_USAGE)

    @classmethod
    def settings(cls, repo, variables):
        needed = ["WA_PLANE_URL", "WA_PLANE_WORKSPACE", "WA_PLANE_PROJECT_ID", "WA_PLANE_STATES"]
        missing = [v for v in needed if v not in variables]
        if missing:
            raise Failure(f"{repo} has no {', '.join(missing)} variable — run /wa-setup backlog (provision)")
        url, slug, project_id = variables["WA_PLANE_URL"].rstrip("/"), variables["WA_PLANE_WORKSPACE"], variables["WA_PLANE_PROJECT_ID"]
        base = f"workspaces/{slug}/projects/{project_id}"
        project = plane_api(url, "GET", f"{base}/")
        states = plane_all(url, f"{base}/states/")
        labels = plane_all(url, f"{base}/labels/")
        state_ids = json.loads(variables["WA_PLANE_STATES"])
        known = {s["id"] for s in states}
        lost = [s for s in PLANE_STATES if state_ids.get(s) not in known]
        if lost:
            raise Failure(f"Plane states missing for {lost} — run provision again")
        return {
            "plane_url": url,
            "workspace": slug,
            "project_id": project_id,
            "project_key": project["identifier"],
            "project_url": f"{url}/{slug}/projects/{project_id}/issues/",
            "state_ids": {s: state_ids[s] for s in PLANE_STATES},
            "state_names": {s["id"]: s["name"] for s in states},  # every column, extras included
            "state_groups": {s["id"]: s["group"] for s in states},
            "label_ids": {l["name"]: l["id"] for l in labels if l["name"] in PLANE_LABELS},
        }

    def base(self):
        return f"workspaces/{self.config['workspace']}/projects/{self.config['project_id']}"

    def api(self, method, path, body=None, missing=()):
        return plane_api(self.config["plane_url"], method, path, body, missing)

    # ------------------------------------------------ reading

    def key(self, item):
        return f"{self.config['project_key']}-{item['sequence_id']}"

    def logins(self, ids):
        if not ids:
            return []
        if self.members is None:
            rows = self.api("GET", f"workspaces/{self.config['workspace']}/members/")
            self.members = {m["id"]: m["display_name"] for m in (rows or [])}
        return [self.members.get(i, i) for i in ids]

    def to_ticket(self, item):
        config = self.config
        state_id = item["state"]
        if state_id not in config["state_names"]:
            raise StaleCache(f"unknown Plane state {state_id}")
        state = {i: s for s, i in config["state_ids"].items()}.get(state_id)
        group = config["state_groups"][state_id]
        labels = set(item.get("labels") or [])
        assignees = self.logins(item.get("assignees") or [])
        key = self.key(item)
        self.items[key] = item
        return {
            "number": key,
            "title": item["name"],
            "summary": summary_of(text_of(item.get("description_html"))),
            "state": state if state in STATES else None,  # canceled: no contract state, closed + not_planned
            "column": config["state_names"][state_id],
            "size": None,
            "sprint": None,
            "milestone": None,
            "closed": group in ("completed", "cancelled"),
            "not_planned": group == "cancelled",
            "ignored": bool(labels & set(config["label_ids"].values())),
            "assignees": assignees,
            # Assigned to someone else: a human reserved it, no agent of another account may claim it.
            "reserved": bool(assignees) and self.me() not in assignees,
            "claims": [],  # the core fills it in, here so the key keeps its place in the output
            "url": self.ticket_url(key),
            "item_id": item["id"],
        }

    def tickets(self):
        """Priority order: Plane's sort_order (lower = higher on the board), drafts and archived cards left out."""
        items = plane_all(self.config["plane_url"], f"{self.base()}/work-items/?order_by=sort_order")
        return [self.to_ticket(i) for i in items if not i.get("is_draft") and not i.get("archived_at")]

    def item(self, number):
        if number in self.items:
            return self.items[number]
        key = self.config["project_key"]
        if number.rsplit("-", 1)[0] != key:
            raise Failure(f"{number} is not on this board: its tickets are {key}-<n>", EXIT_USAGE)
        item = self.api("GET", f"workspaces/{self.config['workspace']}/work-items/{number}/", missing=(404,))
        if not item or item.get("project") != self.config["project_id"]:
            raise Failure(f"{number} does not exist")
        return item

    def get(self, number):
        ticket = self.to_ticket(self.item(number))
        ids = set(self.items[number].get("labels") or [])
        if self.config["label_ids"].get(SPRINT_LABEL) in ids:
            raise Failure(f"{number} is sprint {ticket['title']!r}, not a ticket", EXIT_WRONG_STATE)
        if self.config["label_ids"].get(IGNORE_LABEL) in ids:
            raise Failure(f"{number} is labeled {IGNORE_LABEL}, not a ticket", EXIT_WRONG_STATE)
        return ticket

    def blocked_by(self, number):
        relations = self.api("GET", f"{self.base()}/work-items/{self.item(number)['id']}/relations/") or {}
        rows = []
        for blocker in relations.get("blocked_by", []):
            if blocker["project_id"] != self.config["project_id"]:
                continue  # another project's card: not a ticket of this board
            item = self.api("GET", f"{self.base()}/work-items/{blocker['issue_id']}/")
            group = self.config["state_groups"].get(item["state"])
            rows.append({"number": self.key(item), "state": "closed" if group in ("completed", "cancelled") else "open"})
        return rows

    @functools.cache
    def me(self):
        return self.api("GET", "users/me/")["display_name"]

    def ticket_url(self, number):
        return f"{self.config['plane_url']}/{self.config['workspace']}/browse/{number}/"

    # ------------------------------------------------ writing

    def set_size(self, ticket, size):
        raise Failure("size has no meaning on a Plane board (Plane CE cannot create estimates over its API)", EXIT_USAGE)

    def create(self, title, body, milestone=None, size=None, sprint=None):
        if sprint:
            raise self.unsupported("sprint")
        if milestone:
            raise self.unsupported("milestone")
        if size:
            note(f"size {size} not stored: a Plane board has no size")
        # Explicit todo state: Plane puts the card at the bottom of that column (highest sort_order + 10000).
        item = self.api("POST", f"{self.base()}/work-items/", {
            "name": title, "description_html": html_of(body), "state": self.config["state_ids"]["todo"],
        })
        key = self.key(item)
        return {"number": key, "url": self.ticket_url(key), "milestone": None}

    def milestones(self):
        return []  # Plane modules: not built yet; a board without milestones answers []

    # ------------------------------------------------ other

    @classmethod
    def provision(cls, args, repo):
        if args.title or args.template:
            raise Failure("a Plane project is adopted, never created here: create it in Plane, then pass --project", EXIT_USAGE)
        if not (args.plane_url and args.workspace and args.project):
            raise Failure("Plane provision needs --plane-url, --workspace and --project <identifier or id>", EXIT_USAGE)
        url, slug = args.plane_url.rstrip("/"), args.workspace
        projects = plane_all(url, f"workspaces/{slug}/projects/")
        project = next((p for p in projects if args.project in (p["identifier"], p["id"])), None)
        if not project:
            known = ", ".join(p["identifier"] for p in projects) or "none"
            raise Failure(f"no Plane project {args.project!r} in workspace {slug} (projects: {known})", EXIT_USAGE)
        base = f"workspaces/{slug}/projects/{project['id']}"
        names = {}
        for pair in args.state or []:
            state, _, name = pair.partition("=")
            if state not in PLANE_STATES:
                raise Failure(f"unknown state {state!r}, expected one of {list(PLANE_STATES)}", EXIT_USAGE)
            names[state] = name
        state_ids, report = ensure_plane_states(url, base, names, args.prune_status)
        labels_created = ensure_plane_labels(url, base)
        prepare_repo(repo)
        variables = {
            "WA_PLANE_URL": url,
            "WA_PLANE_WORKSPACE": slug,
            "WA_PLANE_PROJECT_ID": project["id"],
            "WA_PLANE_STATES": json.dumps(state_ids),
            **code_variables(args),
        }
        set_variables(repo, variables)
        config = load(refresh=True)
        secret = gh(["secret", "list", "--repo", repo, "--json", "name", "--jq", ".[].name"], check=False).stdout.split()
        remaining = plane_call(url, "GET", "users/me/")[1].get("X-RateLimit-Remaining")
        return {
            "project_url": config["project_url"],
            "project_key": project["identifier"],
            "project_id": project["id"],
            "states_created": report["created"],
            "states_updated": report["updated"],
            "states_removed": report["removed"],
            "states_extra": report["extra"],
            "states_held": report["held"],
            "default_state_changed": report["default_changed"],
            "labels_created": labels_created,
            "state_ids": state_ids,
            "variables": variables,
            "secret_WA_PLANE_API_KEY": "WA_PLANE_API_KEY" in secret,
            "api_rate_limit_remaining": int(remaining) if (remaining or "").isdigit() else None,
            "api_rate_limit_lifted": (remaining or "").isdigit() and int(remaining) > PLANE_LIFTED,
        }


BOARDS = {"github": GitHubBoard, "plane": PlaneBoard}


# ---------------------------------------------------------------- claims and branches (code host)


def prepare_repo(repo):
    # A PR based on a branch outside a GitHub stack retargets only when that branch is deleted on merge.
    rest("PATCH", f"repos/{repo}", {"delete_branch_on_merge": True})


# Ticket id: a GitHub issue number (int, shown #12) or a board key <PROJECT>-<n> (str, shown as is).
# Branch <prefix><id>-<slug>, task file <id>-<slug>.md, claim ref refs/wa-claims/<id>/<phase>.
TICKET_ID = re.compile(r"\d+|[A-Z][A-Z0-9]{0,11}-\d+")


def ticket_id(text):
    """Ticket id from the command line, a claim ref or a branch: "12" → 12, "WA-42" → "WA-42"."""
    if not TICKET_ID.fullmatch(text):
        raise ValueError(f"not a ticket id: {text!r}")
    return int(text) if text.isdigit() else text


def shown(number):
    return f"#{number}" if isinstance(number, int) else number


def claims(config, number=None):
    """Live claims, all of them or one ticket's. Map by number, or list when number given."""
    scope = f"{CLAIM_NAMESPACE}/{number}/" if number is not None else f"{CLAIM_NAMESPACE}/"
    code, data = rest("GET", f"repos/{config['repo']}/git/matching-refs/{scope}", check=False)
    if code != 0 or not isinstance(data, list):
        raise Failure(f"could not list claims: {(data or {}).get('message', 'gh api failed') if isinstance(data, dict) else 'gh api failed'}")
    found = {}
    for ref in data:
        _, _, held_by, phase = ref["ref"].split("/", 3)
        found.setdefault(ticket_id(held_by), []).append({"phase": phase, "sha": ref["object"]["sha"]})
    return found if number is None else found.get(number, [])


def claim_fields(config, sha):
    """Trailer lines of a claim commit (agent, claimed, assigned), plus its commit date."""
    commit = rest("GET", f"repos/{config['repo']}/git/commits/{sha}")
    fields = dict(
        line.split(": ", 1) for line in commit["message"].splitlines()[1:] if ": " in line
    )
    return {**fields, "date": commit["committer"]["date"]}


def claim_owner(config, sha):
    fields = claim_fields(config, sha)
    return {"agent": fields.get("agent", "?"), "since": fields["date"]}


def with_claims(config, ticket, held, with_owners=False, keep_sha=False):
    """The board's ticket with its live claims (owner fields resolved on demand, one call per claim)."""
    if with_owners:
        held = [{**c, **claim_owner(config, c["sha"])} for c in held]
    ticket["claims"] = [dict(c) if keep_sha else {k: v for k, v in c.items() if k != "sha"} for c in held]
    return ticket


def find(board, number, with_owners=True):
    return with_claims(board.config, board.get(number), claims(board.config, number), with_owners)


def agent_id(explicit=None):
    if explicit:
        return explicit
    if os.environ.get("WA_AGENT"):
        return os.environ["WA_AGENT"]
    try:
        where = git("rev-parse", "--show-toplevel")
    except subprocess.CalledProcessError:
        where = os.getcwd()
    return f"{socket.gethostname().split('.')[0]}:{where}"


def claim_tree(config):
    """One-file tree for claim commits; created once, kept in the cache.

    Never reuse a branch tree: once it holds `.github/workflows/`, GitHub refuses (404) a ref to a
    commit adding workflow files unless the token has the `workflow` scope.
    """
    if not config.get("claim_blob_tree"):
        tree = rest("POST", f"repos/{config['repo']}/git/trees", {
            "tree": [{"path": "CLAIM", "mode": "100644", "type": "blob", "content": "whackagent claim\n"}],
        })
        config["claim_blob_tree"] = tree["sha"]
        cache_path().write_text(json.dumps(config, indent=2))
    return config["claim_blob_tree"]


def remote_branch(config, number):
    code, data = rest(
        "GET", f"repos/{config['repo']}/git/matching-refs/heads/{config['branch_prefix']}{number}-", check=False
    )
    names = [r["ref"].removeprefix("refs/heads/") for r in data or []]
    return names[0] if names else None


def task_phase(config, branch):
    """`phase:` of the task file on a ticket branch (`in-progress`, `review`, `validated`); None when
    the branch or file is missing or the field is empty. Branch `wa/12-login` holds `{tasks}/12-login.md`."""
    if not branch:
        return None
    path = f"{config['tasks_path'].rstrip('/')}/{branch.removeprefix(config['branch_prefix'])}.md"
    code, data = rest("GET", f"repos/{config['repo']}/contents/{path}?ref={quote(branch, safe='')}", check=False)
    if code != 0 or not data or "content" not in data:
        return None
    text = base64.b64decode(data["content"]).decode("utf-8", "replace")
    match = re.search(r"^phase:[ \t]*([\w-]*)", text, re.M)
    return (match.group(1) or None) if match else None


# ---------------------------------------------------------------- operations


def op_config(args):
    emit(load(refresh=args.refresh))


def op_list(args):
    board = open_board()
    config = board.config
    claim_map = claims(config)
    wanted = set(args.state.split(",")) if args.state else None
    rows = []
    for ticket in board.tickets():
        if ticket.get("draft"):
            if not wanted and not args.sprint and not args.milestone:  # drafts: only in unfiltered lists
                rows.append(ticket)
            continue
        with_claims(config, ticket, claim_map.get(ticket["number"], []), keep_sha=args.owners)
        if ticket["ignored"]:
            continue
        if ticket["closed"] and not args.all:  # canceled, split parent: closed without a merge
            continue
        if wanted and ticket["state"] not in wanted:
            continue
        if not wanted and not args.all and ticket["state"] == "done":
            continue
        if args.sprint and ticket["sprint"] != sprint_name(args.sprint):
            continue
        if args.milestone and ticket["milestone"] != args.milestone:
            continue
        rows.append(ticket)
    # review = humans on turn; the task file's phase says which turn (test, retest, merge)
    review = [t for t in rows if t.get("state") == "review"]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        phases = pool.map(lambda t: task_phase(config, remote_branch(config, t["number"])), review)
        for ticket, phase in zip(review, phases):
            ticket["phase"] = phase
    if args.owners:
        claimed = [c for t in rows for c in t.get("claims", [])]
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            for claim, owner in zip(claimed, pool.map(lambda c: claim_owner(config, c["sha"]), claimed)):
                claim.update(owner)
    for t in rows:
        for c in t.get("claims", []):
            c.pop("sha", None)
    emit(rows)


def op_get(args):
    board = open_board()
    config = board.config
    ticket = find(board, args.number)
    ticket["branch"] = remote_branch(config, args.number)
    ticket["phase"] = task_phase(config, ticket["branch"])
    ticket["blocked_by"] = board.blocked_by(args.number)
    emit(ticket)


def op_create(args):
    board = open_board()
    body = args.summary + ("\n\n" + args.note if args.note else "")
    created = board.create(args.title, body, args.milestone, args.size, args.sprint)
    emit({"number": created["number"], "url": created["url"], "state": "todo", "milestone": created["milestone"]})


def op_claim(args):
    board = open_board()
    config = board.config
    phase = args.phase
    ticket = find(board, args.number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"{shown(args.number)} is closed", EXIT_WRONG_STATE)
    if ticket["reserved"]:
        who = ", ".join(f"@{a}" for a in ticket["assignees"])
        emit({"number": args.number, "phase": phase, "taken": True, "agent": who, "assigned": True})
        raise Failure(f"{shown(args.number)} is assigned to {who}, not to @{board.me()}", EXIT_TAKEN)
    ref = f"refs/{CLAIM_NAMESPACE}/{args.number}/{phase}"
    agent = agent_id(args.agent)
    held = next((c for c in claims(config, args.number) if c["phase"] == phase), None)
    if held:  # before the state check, so a loser learns who holds it; leaves no commit behind
        owner = claim_owner(config, held["sha"])
        if owner["agent"] == agent:  # a retry by the holder (say after a failed run): still yours
            emit({"number": args.number, "phase": phase, "taken": False, "agent": agent, "since": owner["since"], "already": True})
            return
        taken(config, args.number, phase, held["sha"])
    if ticket["state"] not in CLAIM_FROM[phase]:
        where = ticket["state"] or f"in column {ticket['column']!r}"
        raise Failure(f"{shown(args.number)} is {where}, {phase} needs {sorted(CLAIM_FROM[phase])}", EXIT_WRONG_STATE)
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    # The winner assigns its account, so other accounts' agents see the ticket reserved. Recorded
    # in the claim so `release` gives back only an assignment this claim made.
    login = board.me()
    assigning = login not in ticket["assignees"]
    trailer = f"assigned: {login}\n" if assigning else ""
    commit = rest(
        "POST",
        f"repos/{config['repo']}/git/commits",
        {
            "message": f"wa-claim {phase} {shown(args.number)}\n\nagent: {agent}\nclaimed: {now}\n{trailer}",
            "tree": claim_tree(config),
            "parents": [],
        },
    )
    code, data = rest("POST", f"repos/{config['repo']}/git/refs", {"ref": ref, "sha": commit["sha"]}, check=False)
    if code != 0:
        if (data or {}).get("message") != "Reference already exists":
            raise Failure(f"could not create claim ref {ref}: {(data or {}).get('message', 'unknown error')}")
        existing = rest("GET", f"repos/{config['repo']}/git/ref/{ref.removeprefix('refs/')}")
        taken(config, args.number, phase, existing["object"]["sha"])
    if ticket["state"] == "grilled":
        # Both phases claim from `grilled` (re-grill, code) on two refs, so the ref alone isn't the lock.
        # Checked after creating ours: of two racers, the later checker always sees the other one. Two
        # simultaneous checkers can both back off: never two winners, at worst none (claim again later).
        other = next((c for c in claims(config, args.number) if c["phase"] != phase), None)
        if other:
            rest("DELETE", f"repos/{config['repo']}/git/{ref}", check=False)
            taken(config, args.number, other["phase"], other["sha"])
    try:
        board.set_state(ticket, phase)
    except BaseException:  # a lock on a card that never moved misleads everyone: give the ref back
        rest("DELETE", f"repos/{config['repo']}/git/{ref}", check=False)
        raise
    if assigning and not board.assign(args.number, login):
        note(f"warning: claim held, but could not assign @{login} to {shown(args.number)}")
    board.comment(args.number, f"🔒 **{phase}** — `{agent}` · {now}")
    emit({"number": args.number, "phase": phase, "taken": False, "agent": agent, "since": now})


def taken(config, number, phase, sha):
    owner = claim_owner(config, sha)
    emit({"number": number, "phase": phase, "taken": True, **owner})
    raise Failure(f"{shown(number)} {phase} already claimed by {owner['agent']} since {owner['since']}", EXIT_TAKEN)


def op_release(args):
    board = open_board()
    config = board.config
    ref = f"{CLAIM_NAMESPACE}/{args.number}/{args.phase}"
    held = next((c for c in claims(config, args.number) if c["phase"] == args.phase), None)
    assigned = claim_fields(config, held["sha"]).get("assigned") if held else None
    code, data = rest("DELETE", f"repos/{config['repo']}/git/refs/{ref}", check=False)
    if code != 0 and held:  # the ref is there but stays: never reset a card whose lock is still held
        raise Failure(f"could not release {ref}: {(data or {}).get('message', 'gh api failed')}")
    if code == 0 and assigned:  # undo only the assignment this claim made; a human's stays
        board.unassign(args.number, assigned)
    if args.reset_to:
        board.set_state(find(board, args.number, with_owners=False), args.reset_to)
    reason = f" — {args.reason}" if args.reason else ""
    target = f", back to **{args.reset_to}**" if args.reset_to else ""
    board.comment(args.number, f"🔓 **{args.phase}** released{target}{reason}")
    emit({"number": args.number, "phase": args.phase, "released": code == 0, "state": args.reset_to})


def op_set_state(args):
    board = open_board()
    board.set_state(find(board, args.number, with_owners=False), args.state)
    emit({"number": args.number, "state": args.state})


def op_move(args):
    open_board().move(args.number, before=args.before, after=args.after, bottom=args.bottom)
    emit({"number": args.number, "moved": True})


def op_milestones(args):
    emit(open_board().milestones())


def op_close_milestone(args):
    """Close a shipped milestone. Only /wa-release calls it, on the user's yes."""
    open_board().close_milestone(args.title)
    emit({"title": args.title, "open": False})


def op_set_field(args):
    board = open_board()
    if args.field == "size":
        if args.value not in SIZES:
            raise Failure(f"size must be one of {SIZES}", EXIT_USAGE)
        board.set_size(find(board, args.number, with_owners=False), args.value)
    elif args.field == "sprint":
        board.set_sprint(args.number, args.value)
    else:
        board.set_milestone(args.number, args.value)
    emit({"number": args.number, args.field: args.value or None})


def op_split(args):
    """The ticket becomes the root of its split: sprint named after its title, off the board, children
    join it (create --sprint <name>). Number, history and milestone stay."""
    board = open_board()
    number = args.number
    ticket = find(board, number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"{shown(number)} is closed", EXIT_WRONG_STATE)
    if ticket["sprint"]:  # sprints don't nest: the children join this one instead
        raise Failure(f"{shown(number)} is already in sprint {ticket['sprint']!r}", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"{shown(number)} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    name = sprint_name(ticket["title"])
    if not name:
        raise Failure(f"{shown(number)} title has no letter or digit to name a sprint", EXIT_USAGE)
    board.split(ticket, name)
    emit({"number": number, "sprint": name})


def op_comment(args):
    board = open_board()
    if args.body_file is None:
        text = args.text
    elif args.body_file == "-":
        text = sys.stdin.read()
    else:
        text = Path(args.body_file).read_text()
    board.comment(args.number, text)
    emit({"number": args.number, "commented": True})


def op_depend(args):
    """Record that <number> is blocked by each ticket in --on. Idempotent."""
    added, kept = open_board().depend(args.number, args.on)
    emit({"number": args.number, "blocked_by_added": added, "blocked_by_existing": kept})


def op_link_pr(args):
    """Manual closing link from PR <pr> to ticket <n>. Idempotent. Repair only: the hooks link every
    open PR whose ticket they find (`Closes #n` in the body, or a wa/<n>-… branch)."""
    open_board().link_pr(args.number, args.pr)
    emit({"number": args.number, "pr": args.pr, "linked": True})


def op_claims(args):
    config = load()
    now = dt.datetime.now(dt.timezone.utc)

    def row(number, claim):
        branch = remote_branch(config, number)
        last_push = None
        if branch:
            head = rest("GET", f"repos/{config['repo']}/commits/{branch}")
            last_push = head["commit"]["committer"]["date"]
        owner = claim_owner(config, claim["sha"])
        latest = max(filter(None, [owner["since"], last_push]))
        age = now - dt.datetime.fromisoformat(latest.replace("Z", "+00:00"))
        return {
            "number": number,
            "phase": claim["phase"],
            **owner,
            "branch": branch,
            "last_activity": latest,
            "stale": age.total_seconds() > config["stale_after_hours"] * 3600,
        }

    work = [(number, claim) for number, held in sorted(claims(config).items()) for claim in held]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        emit(list(pool.map(lambda job: row(*job), work)))


def op_whoami(args):
    emit({"agent": agent_id(args.agent), "login": viewer_login()})


