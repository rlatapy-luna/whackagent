class Failure(Exception):
    def __init__(self, message, code=EXIT_ERROR):
        super().__init__(message)
        self.code = code


class StaleCache(Exception):
    """Board holds ids the cache doesn't know: the board changed since the cache was built."""


# ---------------------------------------------------------------- gh plumbing


def gh(args, payload=None, check=True):
    proc = subprocess.run(
        ["gh", *args],
        input=json.dumps(payload) if payload is not None else None,
        capture_output=True,
        text=True,
    )
    if check and proc.returncode != 0:
        raise Failure(f"gh {' '.join(args[:3])}: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc


def rest(method, path, body=None, check=True):
    args = ["api", "-X", method, path]
    if body is not None:
        args += ["--input", "-"]
    proc = gh(args, body, check=check)
    out = proc.stdout.strip()
    data = json.loads(out) if out else None
    return (proc.returncode, data) if not check else data


def graphql(query, **variables):
    data = rest("POST", "graphql", {"query": query, "variables": variables})
    if data.get("errors"):
        raise Failure("graphql: " + "; ".join(e.get("message", "") for e in data["errors"]))
    return data["data"]


@functools.cache
def viewer_login():
    return graphql("query{viewer{login}}")["viewer"]["login"]


def emit(value):
    json.dump(value, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def note(message):
    print(message, file=sys.stderr)


# ---------------------------------------------------------------- settings


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def cache_path():
    return Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")) / "whackagent" / "github-cache.json"


def current_repo():
    if os.environ.get("GITHUB_ACTIONS") == "true" and os.environ.get("GITHUB_REPOSITORY"):  # a hooks run
        return os.environ["GITHUB_REPOSITORY"]
    return gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).stdout.strip()


def repo_variables(repo):
    # Hooks run: the workflow hands the variables over (WA_VARS = toJSON(vars)); GITHUB_TOKEN cannot list them.
    if os.environ.get("WA_VARS"):
        return {k: v for k, v in json.loads(os.environ["WA_VARS"]).items() if isinstance(v, str)}
    data = rest("GET", f"repos/{repo}/actions/variables?per_page=100")
    return {v["name"]: v["value"] for v in data.get("variables", [])}


def set_variables(repo, variables):
    for name, value in variables.items():
        gh(["variable", "set", name, "--repo", repo, "--body", value])


def fingerprint(variables):
    settings = {k: v for k, v in sorted(variables.items()) if k.startswith("WA_")}
    return hashlib.sha256(json.dumps(settings).encode()).hexdigest()


def board_name():
    """`backlog.provider` of the project config; None without one (a vendored copy in a repo without whackagent)."""
    try:
        text = (Path(git("rev-parse", "--show-toplevel")) / ".whackagent" / "config.md").read_text()
    except (subprocess.CalledProcessError, OSError):
        return None
    block = None
    for line in text.splitlines():
        top = re.match(r"(\w+):", line)
        if top:
            block = top.group(1)
        field = re.match(r"\s+provider:[ \t]*([\w-]+)", line)
        if block == "backlog" and field:
            return field.group(1)
    return None


def board_class():
    # No board of that name (no config, `local`): the GitHub board, the only one before the choice existed.
    return BOARDS.get(board_name(), GitHubBoard)


def code_settings(variables):
    """Code-host settings every board shares: where task files and ticket branches live."""
    return {
        "tasks_path": variables.get("WA_TASKS_PATH", ".whackagent/tasks"),
        "branch_prefix": variables.get("WA_BRANCH_PREFIX", "wa/"),
        # "none" = sprints have no branch (an empty variable reads as unset), as WA_SPRINT_PREFIX in board.yml
        "sprint_prefix": "" if variables.get("WA_SPRINT_PREFIX") == "none" else variables.get("WA_SPRINT_PREFIX", "sprint/"),
        "stale_after_hours": int(variables.get("WA_STALE_AFTER_HOURS", "24")),
        "tracks": json.loads(variables.get("WA_TRACKS", "[]")),
    }


def code_variables(args):
    """Repo variables `provision` writes for the code host, after the board's own."""
    return {
        "WA_TASKS_PATH": args.tasks_path,
        "WA_BRANCH_PREFIX": args.branch_prefix,
        "WA_SPRINT_PREFIX": args.sprint_prefix or "none",  # "none": an empty variable reads as unset
        "WA_STALE_AFTER_HOURS": str(args.stale_after_hours),
        "WA_TRACKS": json.dumps(args.track or []),
    }


def load(refresh=False):
    """Settings from repo variables, ids from the board. The cache is reused only while the
    variables are unchanged (one cheap call per run), so a re-provision elsewhere is picked up."""
    path = cache_path()
    cached = json.loads(path.read_text()) if path.exists() else None
    repo = cached["repo"] if cached else current_repo()
    variables = repo_variables(repo)
    # a cache written before a code setting existed is rebuilt, never read with the setting missing; so is one of
    # another board (backlog.provider switched, e.g. by migrate), the board's own ids differing
    board = board_class()
    fresh = cached and cached.get("fingerprint") == fingerprint(variables) and set(code_settings(variables)) <= set(cached)
    if fresh and not refresh and cached.get("board", "GitHubBoard") == board.__name__:
        return cached
    config = {
        "repo": repo,
        "board": board.__name__,
        **board.settings(repo, variables),
        "fingerprint": fingerprint(variables),
        **code_settings(variables),
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2))
    return config


def open_board(refresh=False):
    return board_class()(load(refresh))


def sprint_name(title):
    """Kebab-case of a sprint title: the branch-safe name. Same rule as sprintName() in the hooks."""
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")


def summary_of(body):
    for line in (body or "").splitlines():
        line = line.strip()
        if line and not line.startswith("<!--"):
            return line
    return ""


# ---------------------------------------------------------------- board interface


class Board:
    """What a board tool provides (module docstring lists the operations). Holds the loaded config."""

    name = "this"

    def __init__(self, config):
        self.config = config

    @classmethod
    def unsupported(cls, operation):
        return Failure(f"{operation} has no meaning on {cls.name} board", EXIT_USAGE)

    @classmethod
    def check_id(cls, number):
        pass

    @classmethod
    def settings(cls, repo, variables):
        raise cls.unsupported("settings")

    def tickets(self):
        raise self.unsupported("list")

    def get(self, number):
        raise self.unsupported("get")

    def blocked_by(self, number):
        raise self.unsupported("blocked by")

    def me(self):
        raise self.unsupported("assignment")

    def assigned_to_me(self, ticket):
        return self.me() in ticket["assignees"]

    def set_state(self, ticket, state):
        raise self.unsupported("set-state")

    def move(self, number, before=None, after=None, bottom=False):
        raise self.unsupported("move")

    def set_size(self, ticket, size):
        raise self.unsupported("size")

    def assign(self, number, login):
        raise self.unsupported("assignment")

    def unassign(self, number, login):
        raise self.unsupported("assignment")

    def comment(self, number, text):
        raise self.unsupported("comment")

    def cancel(self, ticket):
        raise self.unsupported("cancel")

    def create(self, title, body, milestone=None, size=None, sprint=None):
        raise self.unsupported("create")

    def milestones(self):
        raise self.unsupported("milestones")

    def close_milestone(self, title):
        raise self.unsupported("close-milestone")

